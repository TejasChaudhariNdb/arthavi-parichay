            <th>Feature</th>
            <th class="col-arthavi">Arthavi</th>
            <th>INDmoney</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>Price</strong></td>
            <td class="col-arthavi">₹0 — Free forever</td>
            <td>Free (monetizes via cross-selling)</td>
          </tr>
          <tr>
            <td><strong>Email Access</strong></td>
            <td class="col-arthavi">Zero — never requests Gmail/email access</td>
            <td>Full Gmail read access required</td>
          </tr>
          <tr>
            <td><strong>Data Monetization</strong></td>
            <td class="col-arthavi">None — no cross-selling, no data selling</td>
            <td>Loans, credit cards, insurance, US stocks</td>
          </tr>
          <tr>
            <td><strong>Spam Calls</strong></td>
            <td class="col-arthavi">Zero — doesn't collect phone number at signup</td>
            <td>Users report marketing calls from partners</td>
          </tr>
          <tr>
            <td><strong>Import Method</strong></td>
            <td class="col-arthavi">CAS PDF upload (30 sec, user-controlled)</td>
            <td>Gmail scraping + broker linking</td>
          </tr>
          <tr>
            <td><strong>Family Portfolio</strong></td>
            <td class="col-arthavi">Free multi-profile family tracking</td>
            <td>Basic single-user (Super plan for more)</td>
          </tr>
          <tr>
            <td><strong>AI Features</strong></td>
            <td class="col-arthavi">Ask AI: overlap, sector, risk analysis</td>
            <td>Rule-based notifications only</td>
          </tr>
          <tr>
            <td><strong>Focus</strong></td>
            <td class="col-arthavi">Pure portfolio tracking + analytics</td>
            <td>Super-app: tracking + lending + trading</td>
          </tr>
          <tr>
            <td><strong>XIRR Calculation</strong></td>
