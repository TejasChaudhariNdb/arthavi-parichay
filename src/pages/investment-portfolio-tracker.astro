---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Investment Portfolio Tracker India — All Assets in One Dashboard | Arthavi",
  description: "Track all your investments in India: mutual funds, stocks, gold, fixed deposits, real estate, SIF, and AIF. Free, private, multi-asset portfolio tracker with CAS import.",
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Arthavi Investment Portfolio Tracker",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
      "description": "Consolidate all Indian investment assets into one private dashboard with automated CAS parsing, broker tradebook imports, and cash-flow XIRR."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What investments can Arthavi track?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Arthavi tracks Indian Mutual Funds (via CAMS/KFintech CAS), NSE/BSE listed Stocks (via tradebook CSV), Physical and Digital Gold, Sovereign Gold Bonds (SGB), Bank Fixed Deposits (FD), Recurring Deposits (RD), PPF, EPF, NPS, Real Estate properties, SEBI Specialized Investment Funds (SIF), and AIFs."
          }
        },
        {
          "@type": "Question",
          "name": "Does Arthavi require broker or bank passwords?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Never. Arthavi uses client-side file imports (CAS statements and broker tradebook CSVs) and manual entries. We never ask for your Zerodha, Groww, or net banking passwords."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a free investment tracker for India?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Arthavi is free forever for core portfolio tracking, including multi-PAN family aggregation, automated CAS import, cash-flow XIRR, and capital gains reports."
          }
        }
      ]
    }
  ]
});
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords="investment portfolio tracker india, investment tracker india, all in one investment tracker, portfolio tracker india free, multi asset investment tracker"
  schema={schema}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "Investment Portfolio Tracker", url: "https://arthavi.com/investment-portfolio-tracker/" }
    ]
  }}
>

<main style="padding-top: 7rem; padding-bottom: 5rem;">
  <section style="padding-top: 1rem; position: relative; z-index: 2;">
    <div class="container">

      <div class="section-header text-center fade-in" style="margin-bottom: 3.5rem;">
        <span style="display:inline-block; background: rgba(99,102,241,0.12); border: 1px solid rgba(99,102,241,0.3); color: #a78bfa; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 100px; margin-bottom: 1rem;">Complete Wealth Dashboard · India</span>
        <h1 class="heading-xl" style="margin-bottom: 1rem;">Investment Portfolio Tracker India</h1>
        <p style="max-width: 720px; margin: 0 auto; color: var(--text-muted); font-size: 1.15rem; line-height: 1.6;">
          Consolidate Mutual Funds, Stocks, Gold, Fixed Deposits, Real Estate, and Specialized Funds into one private dashboard. Zero broker logins, true cash-flow XIRR, and an AI Wealth Assistant.
        </p>
        <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 0.9rem 2rem;">Start Tracking Free</a>
          <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 0.9rem 2rem;">Explore Demo</a>
        </div>
      </div>

      <!-- Asset Coverage Table -->
      <div class="glass-panel" style="max-width: 900px; margin: 0 auto 4rem; padding: 2.5rem; border-radius: 16px;">
        <h2 style="margin-top: 0; font-size: 1.6rem; color: var(--text-head); text-align: center; margin-bottom: 2rem;">Comprehensive Asset Coverage</h2>
        <div class="compare-table-wrap">
          <table class="compare-table">
            <thead>
              <tr>
                <th>Asset Class</th>
                <th class="col-arthavi">Supported on Arthavi</th>
                <th>Import / Tracking Method</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Mutual Funds</strong></td>
                <td class="col-arthavi">✓ Full Support</td>
                <td>Automated CAMS &amp; KFintech CAS PDF Import (Client-side decrypted)</td>
              </tr>
              <tr>
                <td><strong>NSE &amp; BSE Stocks</strong></td>
                <td class="col-arthavi">✓ Full Support</td>
                <td>Broker Tradebook CSV (Zerodha, Groww, Angel One, Upstox) + Live Quotes</td>
              </tr>
              <tr>
                <td><strong>Gold, Silver &amp; SGB</strong></td>
                <td class="col-arthavi">✓ Full Support</td>
                <td>Physical Grams (Live Rates), SGB Tranches (Coupons), Digital Gold</td>
              </tr>
              <tr>
                <td><strong>Fixed Deposits (FD)</strong></td>
                <td class="col-arthavi">✓ Full Support</td>
                <td>Multi-Bank Deposits, Accrued Interest, Maturity Timeline</td>
              </tr>
              <tr>
                <td><strong>Recurring Deposits (RD)</strong></td>
                <td class="col-arthavi">✓ Full Support</td>
                <td>Monthly Installment Tracking &amp; Projected Compounding</td>
              </tr>
              <tr>
                <td><strong>Real Estate &amp; Land</strong></td>
                <td class="col-arthavi">✓ Full Support</td>
                <td>Purchase Cost, Market Valuation, Net Equity (Home Loan Offset)</td>
              </tr>
              <tr>
                <td><strong>PPF, EPF &amp; NPS</strong></td>
                <td class="col-arthavi">✓ Full Support</td>
                <td>Tax-Free Fixed Income &amp; Retirement Corpus Aggregation</td>
              </tr>
              <tr>
                <td><strong>SIF &amp; AIF (HNI)</strong></td>
                <td class="col-arthavi">✓ Full Support</td>
                <td>SEBI Specialized Investment Funds (Daily NAV) &amp; AIF Ledgers</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Core Features Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.8rem; margin-bottom: 4rem;">
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">⚡</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">CAS Delta Import</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Upload your latest monthly CAS without duplicate transactions. Preview new transactions, verify changed records, and confirm in one click.
          </p>
        </div>
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">🩺</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">Portfolio Data Health</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Data freshness indicators for every holding. Know your last CAS upload date, live pricing status, and reconciliation warnings.
          </p>
        </div>
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">👨‍👩‍👧‍👦</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">Family Wealth Snapshot</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Download monthly or quarterly consolidated household wealth reports in PDF with optional privacy masking for your CA or planner.
          </p>
        </div>
      </div>

      <!-- FAQ -->
      <div style="max-width: 860px; margin: 0 auto 4rem;">
        <h2 style="font-size: 1.75rem; margin-bottom: 2rem; text-align: center;">Frequently Asked Questions</h2>
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div class="glass-panel" style="padding: 1.8rem; border-radius: 14px;">
            <h3 style="margin-top: 0; font-size: 1.1rem; color: var(--text-head);">How is Arthavi different from single-broker apps?</h3>
            <p style="color: var(--text-muted); margin-bottom: 0; line-height: 1.6;">Broker apps (Zerodha, Groww) only track what you hold with them. Arthavi consolidates all your mutual funds across all AMCs, multiple broker tradebooks, gold, FDs, and real estate into one unified family view without selling investment products.</p>
          </div>
          <div class="glass-panel" style="padding: 1.8rem; border-radius: 14px;">
            <h3 style="margin-top: 0; font-size: 1.1rem; color: var(--text-head);">What plan tiers are available?</h3>
            <p style="color: var(--text-muted); margin-bottom: 0; line-height: 1.6;">Arthavi offers a Free forever tier for core tracking, as well as Check, Silver, and Gold plan tiers for specialized high-net-worth analytics, SIF/AIF support, and family capital gains filing.</p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div style="text-align: center; padding: 2rem 0 3rem;">
        <h2 style="margin-bottom: 1rem;">Experience independent, privacy-first portfolio tracking</h2>
        <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem; margin-right: 1rem;">Start Tracking Free</a>
        <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Try Demo</a>
      </div>

      <nav style="max-width: 860px; margin: 0 auto; padding: 1.5rem; border-radius: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
        <h3 style="font-size: 1rem; margin-bottom: 1rem;">Quick links</h3>
        <ul style="display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; list-style: none; padding: 0;">
          <li><a href="/multi-asset-portfolio-tracker/">Multi-Asset Tracker</a></li>
          <li><a href="/gold-portfolio-tracker/">Gold Tracker</a></li>
          <li><a href="/fixed-deposit-tracker/">Fixed Deposit Tracker</a></li>
          <li><a href="/real-estate-tracker/">Real Estate Tracker</a></li>
          <li><a href="/family-portfolio-tracker/">Family Portfolio Tracker</a></li>
          <li><a href="/cas-delta-import/">CAS Delta Import</a></li>
        </ul>
      </nav>

    </div>
  </section>
</main>

</Layout>
