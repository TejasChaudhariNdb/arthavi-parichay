  title: "What is CAS Statement? Consolidated Account Statement Explained | Arthavi",
  description: "A CAS (Consolidated Account Statement) is an official SEBI document containing your complete mutual fund transaction history. Learn what CAS is, how to download it, and how to use it for portfolio tracking.",
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": "https://arthavi.com/guides/cas-statement-explained/#article",
      "headline": "What is CAS Statement? Consolidated Account Statement Explained",
      "description": "Comprehensive explanation of SEBI Consolidated Account Statements (CAS) from CAMS and KFintech.",
      "url": "https://arthavi.com/guides/cas-statement-explained/",
      "datePublished": "2026-02-16",
      "dateModified": "2026-10-01",
      "image": "https://arthavi.com/images/og-image.png",
      "author": { "@id": "https://arthavi.com/#founder" },
      "publisher": { "@id": "https://arthavi.com/#organization" },
      "reviewedBy": { "@id": "https://arthavi.com/#founder" },
      "inLanguage": "en-IN"
    },
    {
      "@type": "HowTo",
      "name": "How to Get Your CAS Statement",
      "description": "Step-by-step guide to requesting and downloading your Consolidated Account Statement from CAMS or KFintech.",
      "totalTime": "PT3M",
      "step": [
        { "@type": "HowToStep", "name": "Visit CAMS or KFintech website", "text": "Go to camsonline.com or kfintech.com and navigate to the CAS/Consolidated Statement section." },
        { "@type": "HowToStep", "name": "Enter your email and PAN", "text": "Provide the email address and PAN registered with your mutual fund folios." },
        { "@type": "HowToStep", "name": "Select statement type", "text": "Choose 'Detailed Statement' with transaction history (not just summary)." },
        { "@type": "HowToStep", "name": "Download the PDF", "text": "The CAS PDF is emailed to you within minutes. It's password-protected with your PAN." },
        { "@type": "HowToStep", "name": "Upload to Arthavi", "text": "Upload the CAS PDF to Arthavi for automatic portfolio import in under 30 seconds." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What is a CAS statement?", "acceptedAnswer": { "@type": "Answer", "text": "A Consolidated Account Statement (CAS) is an official SEBI-mandated document issued by CAMS or KFintech that contains your complete mutual fund transaction history across all AMCs (Asset Management Companies). It includes every SIP, lump sum, redemption, switch, and dividend transaction with dates, NAVs, and units." } },
        { "@type": "Question", "name": "What is the difference between CAS from CAMS and CAS from KFintech?", "acceptedAnswer": { "@type": "Answer", "text": "CAMS and KFintech are the two Registrar and Transfer Agents (RTAs) in India. Each covers different AMCs. To get a complete CAS covering all your mutual funds, you can request it from either — both provide a consolidated view of holdings across all AMCs regardless of the RTA." } },
        { "@type": "Question", "name": "Is CAS statement safe to share with a portfolio tracker?", "acceptedAnswer": { "@type": "Answer", "text": "A CAS is a read-only document that contains transaction history but not your bank account details, passwords, or trading credentials. It's safe to upload to a trusted tracker like Arthavi, which processes it securely and never stores the raw PDF." } },
        { "@type": "Question", "name": "How often is CAS generated?", "acceptedAnswer": { "@type": "Answer", "text": "CAMS and KFintech can generate a CAS on-demand whenever you request it. SEBI also mandates that RTAs send a monthly CAS via email if you've had transactions during the month, and a half-yearly CAS in September and March." } },
        { "@type": "Question", "name": "What is the password for CAS PDF?", "acceptedAnswer": { "@type": "Answer", "text": "The CAS PDF is password-protected with your PAN number (in uppercase). For example, if your PAN is ABCDE1234F, that's the PDF password." } }
      ]
    }
