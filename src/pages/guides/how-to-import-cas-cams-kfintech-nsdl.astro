        { "@type": "HowToStep", "name": "Go to CAMS Online", "text": "Visit camsonline.com and click on 'Investors' → 'Consolidated Account Statement' (or go directly to the CAS page)." },
        { "@type": "HowToStep", "name": "Select Statement Type", "text": "Choose 'Detailed' and select 'CAMS+KFintech' to include all AMCs in one statement." },
