const page = {
  path: '/sip-tracker/',
  dateModified: '2026-11-27',
  title: 'SIP Tracker India: All Family SIPs, Next Dates, Reminders & XIRR | Arthavi',
  description: 'See every running SIP in your family in one list. Arthavi detects SIPs from your CAS, shows the next SIP date and total monthly commitment, sends reminders before each instalment, and tracks real SIP returns with XIRR.',
  keywords: 'sip tracker, sip tracker app india, track all sips in one place, sip reminder app, family sip tracker, mutual fund sip tracker, sip xirr, upcoming sip dates',
  eyebrow: 'SIP Tracker',
  h1: 'All your family\'s SIPs, dates and returns in one list',
  intro: 'SIPs run quietly across AMCs, folios and family members. Arthavi finds them in your CAS, shows what is due next and how much goes out each month, and reminds you before each instalment.',
  answer: 'Arthavi\'s SIP tracker lists every Systematic Investment Plan across a family\'s mutual fund folios. It detects SIPs automatically from the transactions in a CAMS or KFintech CAS, and you can also add or edit SIPs by hand. For each SIP it shows the scheme, folio, amount, SIP day, status (active or stopped) and family member, and the summary shows the total monthly commitment, total invested so far and the next upcoming SIP. Reminders can be sent a few days before each instalment by push, in-app or email notification. Returns are tracked with XIRR, the correct measure for SIPs.',
