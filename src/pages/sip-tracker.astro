    { label: 'How SIPs get in', value: 'Detected from your CAS, or added by hand' },
    { label: 'Per SIP', value: 'Scheme, folio, amount, SIP day, frequency, status, family member' },
    { label: 'Summary', value: 'Active SIPs, monthly commitment, invested so far, next SIP date' },
    { label: 'Reminders', value: '0 to 14 days before, by push, in-app or email' },
    { label: 'Returns', value: 'XIRR per fund and for the portfolio' },
    { label: 'Price', value: 'Free' },
  ],
  features: [
    { title: 'Found from your CAS', text: 'Arthavi looks for regular instalments in your mutual fund transactions and lists them as SIPs. Re-run detection after each new CAS upload.' },
    { title: 'Whole family in one view', text: 'Each SIP is tagged to a family member, so you can see one person\'s SIPs or every SIP in the household.' },
    { title: 'Monthly commitment', text: 'See how much leaves your bank accounts each month for SIPs, and how much you have invested through them so far.' },
    { title: 'Next SIP and reminders', text: 'The next upcoming SIP is shown on top. Turn on reminders to get a nudge a few days before the debit, so you keep enough balance.' },
    { title: 'Pause or stop', text: 'Mark a SIP as stopped when you cancel it, so it leaves your monthly commitment without losing its history.' },
    { title: 'Real SIP returns', text: 'Absolute return ignores when each instalment went in. Arthavi uses XIRR, so a three-year-old SIP and a new one are compared fairly.' },
  ],
  steps: [
    { name: 'Upload your CAS', text: 'Upload the detailed CAS from CAMS or KFintech for each family member.' },
    { name: 'Open SIPs', text: 'Arthavi lists the SIPs it detected. Add any it missed, or edit amount and SIP day.' },
    { name: 'Turn on reminders', text: 'Choose how many days before each SIP you want a reminder, and how.' },
    { name: 'Track returns', text: 'Check XIRR for each fund and the portfolio on the mutual fund page.' },
  ],
  sections: [
    {
      heading: 'SIP returns: why XIRR and not absolute return',
      paragraphs: [
        'With a SIP, each instalment is invested for a different length of time. Absolute return (gain divided by total invested) ignores this and understates the return of a long-running SIP. XIRR gives the annualised return taking every instalment date into account. Learn more in <a href="/blog/sip-returns-vs-xirr/">SIP returns vs XIRR</a>, or try the <a href="/tools/sip-return-calculator/">SIP return calculator</a>.',
