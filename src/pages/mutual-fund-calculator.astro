---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Mutual Fund Calculator: Lumpsum Returns & Growth | Arthavi",
  description: "Calculate returns on your one-time (lumpsum) mutual fund investments with Arthavi's Mutual Fund Calculator. Plan your financial goals today.",
};
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords="Mutual Fund Calculator, Lumpsum Calculator, Investment Growth, One-time Investment, Mutual Fund Returns, Arthavi"
  schema={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Lumpsum Mutual Fund Returns",
    "description": "Learn how to calculate returns on one-time mutual fund investments using compound interest formula.",
    "step": [{
      "@type": "HowToStep",
      "name": "Enter your total investment",
      "text": "Input the one-time lump sum amount you invested in the mutual fund."
    }, {
      "@type": "HowToStep",
      "name": "Set expected return rate",
      "text": "Enter your expected annual return rate. Equity funds historically return 12-15% p.a."
    }, {
      "@type": "HowToStep",
      "name": "Select investment period",
      "text": "Choose how many years you plan to stay invested."
    }, {
      "@type": "HowToStep",
      "name": "View your projected returns",
      "text": "The calculator shows your invested amount, estimated gains, and total future value."
    }]
  })}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "Calculators", url: "https://arthavi.com/mutual-fund-calculator" }
    ]
  }}
>

    

    <main class="container">
        <div class="page-header fade-in" style="text-align: center; padding: 4rem 0 2rem;margin-top: 31px;">
            <h1>Mutual Fund Calculator</h1>
            <p class="text-muted" style="font-size: 1.2rem; max-width: 600px; margin: 0 auto;">
                Calculate the returns on your Lumpsum (One-time) mutual fund investment.
            </p>
            <div class="switch-mode" style="margin-top:1rem;">
                Looking for SIP? <a href="/sip-calculator" class="switch-link">Go to SIP Calculator</a>
            </div>
        </div>

        <div class="calculator-container fade-in delay-100">
            <div class="calc-grid">
                <div class="inputs-section">
                    <div class="input-group">
                        <label>Total Investment (₹)</label>
                        <div class="range-container">
                            <input type="range" id="investment" min="5000" max="10000000" step="5000" value="100000"
                                oninput="updateMF()">
                            <div class="input-value-box" id="investment-val">1,00,000</div>
                        </div>
                    </div>

                    <div class="input-group">
                        <label>Expected Return Rate (p.a %)</label>
                        <div class="range-container">
                            <input type="range" id="rate" min="1" max="30" step="0.1" value="12" oninput="updateMF()">
                            <div class="input-value-box" id="rate-val">12</div>
                        </div>
                    </div>

                    <div class="input-group">
                        <label>Time Period (Years)</label>
                        <div class="range-container">
                            <input type="range" id="years" min="1" max="30" step="1" value="5" oninput="updateMF()">
                            <div class="input-value-box" id="years-val">5</div>
                        </div>
                    </div>
                </div>

                <div class="result-section">
                    <div class="result-card">
                        <div class="result-item">
                            <div class="result-label">Invested Amount</div>
                            <div class="result-value">₹ <span id="total-invested">1,00,000</span></div>
                        </div>
                        <div class="result-item">
                            <div class="result-label">Est. Returns</div>
                            <div class="result-value">₹ <span id="est-returns">76,234</span></div>
                        </div>
                        <div class="result-item">
                            <div class="result-label">Total Value</div>
                            <div class="result-value highlight">₹ <span id="total-value">1,76,234</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <article class="prose fade-in delay-200" style="max-width: 800px; margin: 0 auto 4rem;">
            <h2>What is a Mutual Fund Calculator?</h2>
            <p>This Mutual Fund Calculator is designed to help you estimate the potential returns on a lumpsum
                investment. If you have a one-time surplus amount to invest, this tool shows you how compounding can
                grow your wealth over time.</p>

            <h3>Lumpsum vs SIP</h3>
            <p>While SIP (Systematic Investment Plan) is about investing small amounts regularly, Lumpsum investing is
                about investing a large chunk of money at once. Lumpsum investments are ideal when you have a surplus
                (like a bonus or windfall) and want to lock it into the market for long-term growth.</p>

            <div style="margin-top: 3rem; text-align: center;">
                <p class="text-muted">See your real portfolio distribution.</p>
                <a href="https://app.arthavi.com" class="btn btn-primary" style="margin-top: 1rem;">Track Portfolio</a>
            </div>
        </article>
    </main>

    

    <script>
        function updateMF() {
            const P = parseFloat(document.getElementById('investment').value);
            const r = parseFloat(document.getElementById('rate').value);
            const n = parseFloat(document.getElementById('years').value);

            // Update display values
            document.getElementById('investment-val').innerText = P.toLocaleString('en-IN');
            document.getElementById('rate-val').innerText = r;
            document.getElementById('years-val').innerText = n;

            // Calculation: FV = P * (1 + r/100)^n
            const FV = P * Math.pow((1 + r / 100), n);
            const estReturns = FV - P;

            document.getElementById('total-invested').innerText = Math.round(P).toLocaleString('en-IN');
            document.getElementById('est-returns').innerText = Math.round(estReturns).toLocaleString('en-IN');
            document.getElementById('total-value').innerText = Math.round(FV).toLocaleString('en-IN');
        }

        // Initialize on load
        window.onload = updateMF;
    </script>
    

</Layout>
