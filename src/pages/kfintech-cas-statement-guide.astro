---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "KFintech CAS Statement Guide — Download & Import Guide | Arthavi",
  description: "Complete guide to downloading and importing your KFintech Consolidated Account Statement. Covered AMCs (Nippon, Axis, UTI, Mirae), password format, and tracking on Arthavi.",
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      "name": "How to Download and Use KFintech CAS Statement",
      "description": "Step-by-step guide to download detailed KFintech CAS and import into Arthavi.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Visit KFintech Investor Portal",
          "text": "Go to mfs.kfintech.com/investor and choose Consolidated Account Statement."
        },
        {
          "@type": "HowToStep",
          "name": "Request Detailed Statement",
          "text": "Select Detailed CAS with period set to Since Inception."
        },
        {
          "@type": "HowToStep",
          "name": "Download and Upload to Arthavi",
          "text": "Check your email for the encrypted PDF and drop it into Arthavi for automatic parsing."
        }
      ]
    }
  ]
});
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords="kfintech cas statement guide, kfintech cas download india, kfintech statement password, karvy cas download"
  schema={schema}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "KFintech CAS Guide", url: "https://arthavi.com/kfintech-cas-statement-guide/" }
    ]
  }}
>

<main style="padding-top: 7rem; padding-bottom: 5rem;">
  <section style="padding-top: 1rem; position: relative; z-index: 2;">
    <div class="container">

      <div class="section-header text-center fade-in" style="margin-bottom: 3.5rem;">
        <span style="display:inline-block; background: rgba(168,85,247,0.12); border: 1px solid rgba(168,85,247,0.3); color: #c084fc; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 100px; margin-bottom: 1rem;">Registrar Guide · KFintech</span>
        <h1 class="heading-xl" style="margin-bottom: 1rem;">KFintech CAS Statement Guide</h1>
        <p style="max-width: 720px; margin: 0 auto; color: var(--text-muted); font-size: 1.15rem; line-height: 1.6;">
          Complete guide to downloading your KFintech (formerly Karvy) Consolidated Account Statement and importing it into Arthavi.
        </p>
      </div>

      <div class="glass-panel" style="max-width: 860px; margin: 0 auto 4rem; padding: 2.5rem; border-radius: 16px;">
        <h2>Which AMCs are serviced by KFintech?</h2>
        <p style="color: var(--text-muted); line-height: 1.7;">
          KFintech services major fund houses including <strong>Nippon India, Axis Mutual Fund, UTI, Mirae Asset, Motilal Oswal, Quant, Invesco, and PGIM India</strong>.
        </p>
        
        <h2>How to download your KFintech CAS</h2>
        <ol style="color: var(--text-muted); line-height: 1.8; padding-left: 1.5rem;">
          <li>Go to <strong>mfs.kfintech.com/investor</strong>.</li>
          <li>Choose <strong>Consolidated Account Statement (CAS)</strong>.</li>
          <li>Select <strong>Detailed CAS</strong> and set period to <strong>Since Inception</strong>.</li>
          <li>Enter your registered email and choose a document password.</li>
        </ol>

        <h2>Combine with CAMS on Arthavi</h2>
        <p style="color: var(--text-muted); line-height: 1.7; margin-bottom: 0;">
          Arthavi's multi-CAS reconciliation engine seamlessly merges statements from both CAMS and KFintech into a single canonical portfolio per investor PAN with zero folio conflicts.
        </p>
      </div>

      <div style="text-align: center; padding: 2rem 0 3rem;">
        <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem; margin-right: 1rem;">Upload KFintech CAS Free</a>
        <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Try Demo</a>
      </div>

      <nav style="max-width: 860px; margin: 0 auto; padding: 1.5rem; border-radius: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
        <h3 style="font-size: 1rem; margin-bottom: 1rem;">Related guides</h3>
        <ul style="display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; list-style: none; padding: 0;">
          <li><a href="/cams-cas-statement-guide/">CAMS CAS Guide</a></li>
          <li><a href="/cas-delta-import/">CAS Delta Import</a></li>
          <li><a href="/track-multiple-mutual-funds/">Track Multiple Mutual Funds</a></li>
        </ul>
      </nav>

    </div>
  </section>
</main>

</Layout>
