---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Contact Arthavi | Support for Investment Tracker Needs",
  description: "Need help with your portfolio tracker? Contact the Arthavi team for support with importing your investment statement, feature requests, or general inquiries.",
};
---
<Layout title={seo.title} description={seo.description}  schema={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ContactPoint",
      "email": "arthaviapp@gmail.com",
      "contactType": "customer support",
      "url": "https://arthavi.com/contact/",
      "areaServed": "IN",
      "availableLanguage": "English"
    })}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "Contact", url: "https://arthavi.com/contact" }
    ]
  }}
>

    
    

    <main class="container">
        <div class="page-header fade-in">
            <h1>Get in Touch</h1>
            <p class="text-muted" style="font-size: 1.2rem;">We are here to help Indian investors on their journey.</p>
        </div>

        <div class="prose contact-grid fade-in delay-100" style="max-width: 1000px;">
            <div class="contact-card glass-panel">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem;">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <h3>App Support</h3>
                <p>Issues importing your investment statement or need help with stock tracking?</p>
                <a href="mailto:arthaviapp@gmail.com">arthaviapp@gmail.com</a>
                <p class="text-xs text-muted" style="margin-top: 0.5rem">Response time: 24-48 hours</p>
            </div>

            <div class="contact-card glass-panel">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <h3>General Inquiries</h3>
                <p>For feedback, partnerships, or questions about our privacy roadmap.</p>
                <a href="mailto:arthaviapp@gmail.com">arthaviapp@gmail.com</a>
            </div>
        </div>

        <div class="prose text-center fade-in delay-200" style="margin-top: 3rem;">
            <p class="text-muted">You can reach us via email or call/WhatsApp us for any urgent issues.</p>
            <div style="font-size: 1.5rem; color: var(--text-head); margin-top: 1rem; font-weight: 600;">
                <a href="tel:+919158110065" style="color: inherit; text-decoration: none;">+91 9158110065</a>
            </div>
            <div style="background: rgba(255, 255, 255, 0.05); padding: 1.5rem; border-radius: 8px; margin-top: 2rem;">
                <p class="text-sm"><strong>Security Note:</strong> Arthavi support staff will <strong>never</strong> ask
                    for your passwords, OTPs, or specific investment advice. Please do not send sensitive financial
                    documents (like bank statements) via open email.</p>
            </div>
        </div>
    </main>

    
    

</Layout>
