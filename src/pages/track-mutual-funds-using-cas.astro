---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "How to Track Mutual Funds Using CAS Statement — Step-by-Step | Arthavi",
  description: "Complete guide on tracking all your mutual funds across AMCs using your Consolidated Account Statement (CAS). Upload to Arthavi for private automated tracking.",
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      "name": "How to Track Mutual Funds Using a CAS Statement",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Request your detailed CAS",
          "text": "Go to CAMS Online or KFintech and request your Detailed Consolidated Account Statement for all folios."
        },
        {
          "@type": "HowToStep",
          "name": "Upload to Arthavi",
          "text": "Upload the password-protected PDF. Decryption happens locally in your browser memory."
        },
        {
          "@type": "HowToStep",
          "name": "View portfolio and XIRR",
          "text": "Arthavi automatically extracts every folio, scheme, and transaction to calculate true cash-flow XIRR."
        }
      ]
    }
  ]
});
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords="track mutual funds using cas, cams cas tracker, kfintech cas import, cas statement guide india"
  schema={schema}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "Track Mutual Funds Using CAS", url: "https://arthavi.com/track-mutual-funds-using-cas/" }
    ]
  }}
>

<main style="padding-top: 7rem; padding-bottom: 5rem;">
  <section style="padding-top: 1rem; position: relative; z-index: 2;">
    <div class="container">

      <div class="section-header text-center fade-in" style="margin-bottom: 3.5rem;">
        <span style="display:inline-block; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #34d399; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 100px; margin-bottom: 1rem;">Investor Guide · CAS Tracking</span>
        <h1 class="heading-xl" style="margin-bottom: 1rem;">How to Track Mutual Funds Using Your CAS Statement</h1>
        <p style="max-width: 720px; margin: 0 auto; color: var(--text-muted); font-size: 1.15rem; line-height: 1.6;">
          Your Consolidated Account Statement (CAS) contains your entire mutual fund history. Learn how to import it into Arthavi safely without sharing passwords.
        </p>
      </div>

      <div class="glass-panel" style="max-width: 860px; margin: 0 auto 4rem; padding: 2.5rem; border-radius: 16px;">
        <h2>The 3-Step Process</h2>
        <ol style="color: var(--text-muted); line-height: 1.8; font-size: 1rem; padding-left: 1.5rem;">
          <li><strong style="color: var(--text-head);">Get your CAS:</strong> Visit CAMS or KFintech website, choose "Detailed Statement" with specific date range "Since Inception". You will receive an encrypted PDF in your email.</li>
          <li><strong style="color: var(--text-head);">Upload to Arthavi:</strong> Drag and drop your CAS PDF. Arthavi decrypts the PDF <em>in-memory on your device</em> — your PDF password is never transmitted to or stored on our servers.</li>
          <li><strong style="color: var(--text-head);">Instant Intelligence:</strong> In 10–15 seconds, Arthavi parses all folios, transaction dates, amounts, and units, computing exact XIRR and asset allocation.</li>
        </ol>
      </div>

      <div style="text-align: center; padding: 2rem 0 3rem;">
        <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem; margin-right: 1rem;">Upload CAS Free</a>
        <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Try Demo</a>
      </div>

      <nav style="max-width: 860px; margin: 0 auto; padding: 1.5rem; border-radius: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
        <h3 style="font-size: 1rem; margin-bottom: 1rem;">Detailed registrar guides</h3>
        <ul style="display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; list-style: none; padding: 0;">
          <li><a href="/cams-cas-statement-guide/">CAMS CAS Statement Guide</a></li>
          <li><a href="/kfintech-cas-statement-guide/">KFintech CAS Statement Guide</a></li>
          <li><a href="/cas-delta-import/">CAS Delta Import</a></li>
        </ul>
      </nav>

    </div>
  </section>
</main>

</Layout>
