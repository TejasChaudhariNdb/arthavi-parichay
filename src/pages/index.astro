              }
            },
            {
              "@type": "Question",
              "name": "Is it SEBI registered?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Arthavi does not provide investment advice or execute trades and therefore does not require a SEBI (Securities and Exchange Board of India) Investment Advisor (RIA) registration. It functions purely as a tracking and analytics technological tool."
              }
            },
            {
              "@type": "Question",
              "name": "Is my data encrypted?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. All sensitive data is encrypted both at rest and during transmission."
              }
            },
            {
              "@type": "Question",
