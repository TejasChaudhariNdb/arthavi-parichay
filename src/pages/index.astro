    <style>
        /* Mobile Floating CTA Styles */
        .mobile-floating-cta {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            z-index: 9999;
            width: calc(100% - 32px);
            max-width: 380px;
            display: none;
            opacity: 0;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
            pointer-events: none;
        }

        .mobile-floating-cta.visible {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
            pointer-events: auto;
        }

        .btn-floating-cta {
            width: 100%;
            padding: 0.95rem 1.5rem;
            border-radius: 100px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--ai-color) 100%);
            box-shadow: 0 10px 25px rgba(99, 102, 241, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #fff !important;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            font-size: 1.05rem;
            font-weight: 600;
            letter-spacing: -0.01em;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            text-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .btn-floating-cta:active {
            transform: scale(0.97);
            box-shadow: 0 6px 15px rgba(99, 102, 241, 0.25);
        }

        .btn-floating-cta svg {
            transition: transform 0.2s ease;
        }

        .btn-floating-cta:active svg {
            transform: translateX(4px);
        }

        @media (max-width: 768px) {
            .mobile-floating-cta {
                display: block;
            }
        }
    </style>

    <script>
        // AI tab switcher
        function switchConv(idx, tabEl) {
            // Update messages
            document.querySelectorAll('#ai-chat-demo .chat-msg').forEach(function (el) {
                el.style.display = parseInt(el.getAttribute('data-conv')) === idx ? '' : 'none';
            });
            // Update tabs
            document.querySelectorAll('.ai-tab').forEach(function (t) { t.classList.remove('active'); });
            if (tabEl) tabEl.classList.add('active');
        }

        // Bind to window to ensure global inline event handlers (onclick) can find it
        if (typeof window !== 'undefined') {
            window['switchConv'] = switchConv;
        }

        // Mobile floating CTA scroll behavior
        document.addEventListener("DOMContentLoaded", () => {
            const floatingCta = document.getElementById('mobile-floating-cta');
            if (floatingCta) {
                const handleScroll = () => {
                    // Show after scrolling 400px down (past hero)
                    if (window.scrollY > 400) {
                        floatingCta.classList.add('visible');
                    } else {
                        floatingCta.classList.remove('visible');
                    }
                };
                
                // Listen to scroll events (passive: true for mobile performance)
                window.addEventListener('scroll', handleScroll, { passive: true });
                // Check initial scroll state
                handleScroll();
            }
        });
    </script>

