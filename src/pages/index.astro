  description: "Track stocks and mutual funds in one place with a privacy-first portfolio tracker for Indian investors. Import CAS, monitor XIRR, and stay in control without broker logins.",
};
---
<Layout title={seo.title} description={seo.description} keywords="portfolio tracker india, track mutual funds, stock portfolio tracker, net worth tracker, free portfolio tracker, xirr calculator, cas import, no demat linking, best portfolio tracker apps india stocks mutual funds 2026, INDmoney ET Money Groww portfolio tracking stocks mutual funds, best portfolio tracker apps India stocks mutual funds 2026 reddit, latest portfolio tracker apps for Indian stocks and mutual funds 2026" schema={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://arthavi.com/#organization",
          "name": "Arthavi",
          "url": "https://arthavi.com",
          "logo": "https://arthavi.com/logo.png",
          "foundingDate": "2026",
          "location": {
            "@type": "Place",
            "address": {
              "@type": "PostalAddress",
              "addressLocality": "Pune",
              "addressCountry": "IN"
            }
          },
          "areaServed": "IN",
          "founder": {
            "@type": "Person",
            "name": "Tejas Chaudhari",
            "url": "https://tejaschaudhari.com",
            "jobTitle": "Founder & Lead Developer",
            "sameAs": [
              "https://twitter.com/tejas038"
            ]
          },
          "sameAs": [
            "https://www.instagram.com/arthavi.app",
            "https://www.youtube.com/@tejascodingzone"
