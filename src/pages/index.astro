        {
          "@type": "WebSite",
          "@id": "https://arthavi.com/#website",
          "url": "https://arthavi.com",
          "name": "Arthavi Portfolio Tracker",
          "publisher": { "@id": "https://arthavi.com/#organization" },
          "inLanguage": "en-IN"
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://arthavi.com/#software",
          "name": "Arthavi",
          "applicationCategory": "FinanceApplication",
          "operatingSystem": "Web, Android",
          "author": { "@id": "https://arthavi.com/#organization" },
          "featureList": [
            "Manual Mutual Fund Tracking",
            "CAS PDF Import from CAMS and KFintech",
            "NSE/BSE Stock Portfolio Monitoring",
            "No Demat Link Required",
            "Privacy-First Architecture",
            "XIRR Calculator based on actual cash flows",
            "Ask AI Investment Assistant",
            "Portfolio Overlap Analysis",
            "Sector Concentration Analysis",
            "Benchmark Comparison with Nifty 50",
            "Goal-Based Portfolio Tracking"
          ],
          "screenshot": "https://arthavi.com/images/dashboard.webp",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "INR"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.8",
            "ratingCount": "12500"
          }
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "What is Arthavi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Arthavi is India's privacy-first, ad-free portfolio tracker that consolidates your mutual funds and stocks in a single dashboard with AI-powered analytics. By importing your CAS statement or adding holdings manually, you get a unified view of your net worth and true XIRR without linking broker accounts."
              }
            },
            {
              "@type": "Question",
              "name": "Is Arthavi free?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, Arthavi's core portfolio tracking features are completely free to use. While advanced analytics and premium tools may be introduced in the future, our core privacy-first tracking and data security will always remain standard and free."
              }
            },
            {
              "@type": "Question",
              "name": "Is my data shared?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No, your financial data is never sold, shared, or monetized with third parties, brokers, or advertisers. Arthavi adheres to a strict privacy-first policy, utilizing your uploaded data solely to compute your personal portfolio analytics."
              }
            },
            {
              "@type": "Question",
              "name": "Does Arthavi execute trades?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No, Arthavi is a read-only analytics platform and does not execute trades, place orders, or hold your funds. You remain in full control of your actual investments via your existing brokers, while Arthavi provides the data intelligence layer."
              }
            },
            {
              "@type": "Question",
              "name": "How is CAS data handled?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Your Consolidated Account Statement (CAS) PDF is processed securely (often locally on your device) to extract transaction details and is never stored, shared, or scanned for advertising. Arthavi uses industry-standard encryption to parse this official, SEBI-regulated document generated by CAMS or KFintech."
              }
            },
            {
              "@type": "Question",
              "name": "Is it SEBI registered?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No, Arthavi does not require SEBI registration because it is a technology platform for tracking and visualization, not a broker or Registered Investment Advisor (RIA). We provide automated data-driven analytics and do not offer customized investment advice or trade execution."
              }
            },
            {
              "@type": "Question",
              "name": "Is my data encrypted?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, all user data is fully encrypted both at rest using bank-grade AES-256 encryption and in transit via secure TLS protocols. This ensures your personal financial information remains confidential and protected."
              }
            },
            {
              "@type": "Question",
              "name": "How do I know my data is safe? Will I receive random marketing calls?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You will never receive marketing calls because Arthavi does not collect phone numbers during signup, nor do we sell or share user data for lead generation. Your information is encrypted at rest and in transit, and we require minimal permissions solely to run your portfolio analytics."
              }
            },
            {
              "@type": "Question",
              "name": "Do you support fixed or debt instruments like FDs, PPF, and NPS?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Arthavi currently supports mutual funds and equity, but tracking for fixed income and debt instruments like FDs, PPF, and NPS is on our active roadmap and coming soon. Our goal is to provide a complete, unified wealth dashboard in India."
              }
            },
            {
              "@type": "Question",
              "name": "How does the Ask AI Investment Assistant work?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The Ask AI Investment Assistant works by parsing your abstract portfolio holdings securely and answering questions in plain English, such as checking for portfolio overlap or sector exposure. It functions as a data-driven personal analyst for your uploaded data."
              }
            },
            {
              "@type": "Question",
              "name": "Is the AI Assistant giving me financial advice?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No, the AI Assistant provides objective, data-driven insights based on your holdings and does not offer certified financial advice, stock tips, or buy/sell recommendations. It is designed to help you interpret your current portfolio metrics."
              }
            },
            {
              "@type": "Question",
              "name": "Does the AI have access to my sensitive login credentials?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No, the AI never has access to your login credentials because Arthavi does not integrate with your brokers or ask for passwords. The AI operates entirely on the anonymized holding data extracted from your uploaded CAS PDF."
              }
            },
            {
              "@type": "Question",
              "name": "Can I track family portfolios or multiple CAS files?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, you can track family portfolios by uploading multiple CAS files belonging to different family members (PANs). Arthavi aggregates these statements into a unified family dashboard to show combined net worth and overall returns."
              }
            },
            {
              "@type": "Question",
              "name": "Is Arthavi better than tracking investments in Excel?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, Arthavi is significantly better than Excel because it automates transaction importing, calculates live XIRR, pulls real-time stock prices, and provides AI insights without manual data entry or complex formulas."
              }
            },
            {
              "@type": "Question",
              "name": "Do I need to link my demat account or broker to use Arthavi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No, you do not need to link your demat account or share broker login credentials to use Arthavi. You can securely import your portfolio using a read-only SEBI CAS PDF from CAMS or KFintech, keeping your account completely secure."
              }
            },
            {
              "@type": "Question",
              "name": "How is the XIRR calculated on Arthavi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Arthavi calculates your XIRR (Extended Internal Rate of Return) based on your actual cash flows and transaction dates extracted from your CAS or manual entries. It accounts for SIPs, lump-sums, redemptions, and dividend payouts for high accuracy."
              }
            },
            {
              "@type": "Question",
              "name": "What happens if I want to delete my account and data?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You have complete control over your data. If you choose to leave Arthavi, you can delete your account at any time. We will permanently wipe all your transaction data, CAS files, and personal information from our servers immediately."
              }
            },
            {
              "@type": "Question",
              "name": "How to track mutual funds in Arthavi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You can track mutual funds in Arthavi by importing a CAS PDF statement or manually adding fund names to view performance charts and automated XIRR calculations."
              }
            },
            {
              "@type": "Question",
              "name": "Is Arthavi safe to use?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, Arthavi is highly secure and safe to use because it operates as a read-only platform, does not link to bank or broker accounts, and does not require credentials or phone numbers. All data is encrypted at rest and in transit."
              }
            },
            {
              "@type": "Question",
              "name": "Can I track NPS on Arthavi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No, NPS tracking is not currently supported, but it is on our development roadmap along with other debt instruments. For now, you can track all your mutual funds and NSE/BSE stock portfolios."
              }
            },
            {
              "@type": "Question",
              "name": "How does Arthavi make money if it is free and ad-free?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Arthavi will make money by introducing premium tiers for advanced analytical tools and custom AI reporting in the future, rather than selling user data or showing ads. The core portfolio tracking features will remain free forever."
              }
            },
            {
              "@type": "Question",
              "name": "Is there a mobile app available for Arthavi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, Arthavi is available as a web app optimized for mobile devices, and native Android/iOS applications are currently in development. You can access the fully responsive dashboard on any smartphone browser."
              }
            },
            {
              "@type": "Question",
              "name": "How does Arthavi fetch live stock prices?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Arthavi fetches live stock prices and mutual fund NAVs directly from real-time market data providers for NSE and BSE stocks, as well as official AMFI feeds for mutual funds. Your portfolio values update automatically."
              }
            },
            {
              "@type": "Question",
              "name": "Can I track my Zerodha and Groww portfolios together on Arthavi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, you can track holdings from Zerodha, Groww, Upstox, and any other broker by uploading your Consolidated Account Statement (CAS). This combines all your holdings into one unified view."
              }
            },
            {
              "@type": "Question",
              "name": "What is the difference between absolute return and XIRR?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Absolute return measures the simple percentage gain on your total investment, whereas XIRR (Extended Internal Rate of Return) calculates your annualized rate of return factoring in the specific dates and amounts of every cash flow. XIRR is the most accurate metric for tracking SIPs and recurring investments."
              }
            },
            {
              "@type": "Question",
              "name": "Can I add transactions manually without uploading a CAS statement?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, Arthavi allows you to manually input stock and mutual fund transactions if you prefer not to upload a CAS statement. This gives you complete flexibility over how you maintain your portfolio data."
              }
            },
            {
              "@type": "Question",
              "name": "Does Arthavi support US stocks or cryptocurrency tracking?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No, Arthavi is strictly focused on Indian financial assets, supporting mutual funds and NSE/BSE listed stocks. We do not support cryptocurrency or US stock tracking to keep the platform highly optimized for Indian investors."
              }
            },
            {
              "@type": "Question",
              "name": "Can Arthavi parse password-protected CAS files?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, Arthavi handles password-protected CAS files by asking you to enter the password locally in your browser during the upload process. The password is never sent to our servers and is only used to decrypt the PDF on your device."
              }
            },
            {
              "@type": "Question",
              "name": "How often should I upload my CAS file to keep my portfolio updated?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "You only need to upload an updated CAS file once a month or after you make new transactions. Once imported, Arthavi updates the current value of your holdings automatically using live market feeds and daily NAVs."
              }
            },
            {
              "@type": "Question",
              "name": "Can I track HUF or corporate investment portfolios on Arthavi?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes, Arthavi supports tracking for HUF, corporate, and individual accounts by importing the respective CAS statements associated with those PANs. You can organize them into separate dashboards or aggregate them."
              }
            }
          ]
        }
      ]
    })}>

    
    
