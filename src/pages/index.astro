    <script>
        // AI tab switcher
        function switchConv(idx, tabEl) {
            // Update messages
            document.querySelectorAll('#ai-chat-demo .chat-msg').forEach(function (el) {
                el.style.display = parseInt(el.getAttribute('data-conv')) === idx ? '' : 'none';
            });
            // Update tabs
            document.querySelectorAll('.ai-tab').forEach(function (t) { t.classList.remove('active'); });
            if (tabEl) tabEl.classList.add('active');
        }

        // Bind to window to ensure global inline event handlers (onclick) can find it
        if (typeof window !== 'undefined') {
            window['switchConv'] = switchConv;
        }

        // Unified Homepage FAQ Search & Filter Engine
        document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.getElementById("faq-search-input") as HTMLInputElement;
            const tabBtns = document.querySelectorAll(".faq-tab-btn");
            const faqItems = document.querySelectorAll("#unified-faq-list .faq-item") as NodeListOf<HTMLElement>;
            const noResults = document.getElementById("faq-no-results");

            let currentFilter = "all";
            let searchQuery = "";

            function filterFAQ() {
                let visibleCount = 0;
                faqItems.forEach((item) => {
                    const cat = item.getAttribute("data-category") || "";
                    const searchIndex = item.getAttribute("data-q") || "";
                    const matchesCat = (currentFilter === "all" || cat === currentFilter);
                    const matchesSearch = (!searchQuery || searchIndex.includes(searchQuery));

                    if (matchesCat && matchesSearch) {
                        item.style.display = "";
                        visibleCount++;
                    } else {
                        item.style.display = "none";
                        item.classList.remove("active"); // close hidden items
                    }
                });

                if (noResults) {
                    noResults.style.display = visibleCount === 0 ? "block" : "none";
                }
            }

            if (searchInput) {
                searchInput.addEventListener("input", (e) => {
                    const target = e.target as HTMLInputElement;
                    searchQuery = target.value.toLowerCase().trim();
                    filterFAQ();
                });
            }

            tabBtns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    tabBtns.forEach((t) => t.classList.remove("active"));
                    btn.classList.add("active");
                    currentFilter = btn.getAttribute("data-filter") || "all";
                    filterFAQ();
                });
            });
        });
    </script>

