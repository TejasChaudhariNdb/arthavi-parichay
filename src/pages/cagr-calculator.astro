---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "CAGR Calculator Online | Compound Annual Growth Rate India | Arthavi",
  description: "Calculate Compound Annual Growth Rate (CAGR) online. Compare absolute returns vs CAGR for your mutual funds and stocks easily.",
};
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords="cagr calculator, compound annual growth rate calculator, cagr vs xirr, calculate cagr online, absolute return vs cagr"
  schema={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate CAGR",
    "description": "Learn how to calculate Compound Annual Growth Rate (CAGR) for your investments.",
    "step": [{
      "@type": "HowToStep",
      "name": "Enter initial investment",
      "text": "Input the amount you initially invested."
    }, {
      "@type": "HowToStep",
      "name": "Enter current value",
      "text": "Input the current value of your investment."
    }, {
      "@type": "HowToStep",
      "name": "Enter holding period",
      "text": "Input the number of years you have held the investment."
    }, {
      "@type": "HowToStep",
      "name": "Calculate CAGR",
      "text": "The formula is CAGR = [(Ending Value / Beginning Value) ^ (1 / Years)] - 1"
    }]
  })}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "CAGR Calculator", url: "https://arthavi.com/cagr-calculator" }
    ]
  }}
>

  <main class="container">
    <div class="page-header fade-in">
      <h1>CAGR Calculator</h1>
      <p class="text-muted" style="font-size: 1.2rem; max-width: 600px; margin: 0 auto;">
        Find your true annualized return — not just total percentage.
      </p>
    </div>

    <div class="calc-page-wrapper">

      <div class="glass-panel calc-result-hero fade-in">
        <p>Your Annualized Return (CAGR)</p>
        <p id="cagr-result">20.11%</p>
        <p><span style="color: #34d399; font-weight: 600;">+150%</span> absolute return over <span id="cagr-years">5</span> years</p>
      </div>

      <div class="glass-panel calc-inputs-panel fade-in delay-100">

        <div class="calc-field">
          <div class="calc-field-header">
            <label>Initial Investment (₹)</label>
            <div class="calc-field-value">
              <span>₹</span>
              <input type="number" id="initial" value="100000" min="1000" max="100000000" step="1000">
            </div>
          </div>
          <input type="range" id="initial-slider" min="1000" max="100000000" step="1000" value="100000">
        </div>

        <div class="calc-field">
          <div class="calc-field-header">
            <label>Current Value (₹)</label>
            <div class="calc-field-value">
              <span>₹</span>
              <input type="number" id="final" value="250000" min="1000" max="1000000000" step="1000">
            </div>
          </div>
          <input type="range" id="final-slider" min="1000" max="1000000000" step="1000" value="250000">
        </div>

        <div class="calc-field">
          <div class="calc-field-header">
            <label>Duration (Years)</label>
            <div class="calc-field-value">
              <input type="number" id="years" value="5" min="1" max="40" step="1">
              <span>Years</span>
            </div>
          </div>
          <input type="range" id="years-slider" min="1" max="40" step="1" value="5">
        </div>
      </div>

      <div class="glass-panel calc-chart-panel fade-in delay-200">
        <p>Growth Comparison</p>
        <svg id="cagr-chart" viewBox="0 0 640 200"></svg>
        <div class="calc-chart-legend">
          <span><span></span> Initial</span>
          <span><span></span> Current Value</span>
        </div>
      </div>

      <div class="calc-stats-grid fade-in delay-300">
        <div class="glass-panel">
          <p>Initial</p>
          <p id="stat-initial">₹1,00,000</p>
        </div>
        <div class="glass-panel">
          <p>Absolute Return</p>
          <p id="stat-abs">+150%</p>
        </div>
        <div class="glass-panel">
          <p>CAGR</p>
          <p id="stat-cagr">20.11%</p>
        </div>
      </div>

      <div class="calc-cta">
        <a href="https://app.arthavi.com" class="btn btn-primary">Track Real Portfolio</a>
        <p>Use Arthavi to calculate XIRR for your SIPs — not just lump-sum CAGR.</p>
      </div>
    </div>

    <article class="prose fade-in">
      <h2>What is a CAGR Calculator?</h2>
      <p>A <strong>CAGR calculator</strong> calculates the Compound Annual Growth Rate. Unlike absolute returns which only show total percentage gained, CAGR smooths out volatility and shows exactly what your investment grew by, on average, every single year.</p>
      <h2>CAGR vs XIRR</h2>
      <p>Only use a <strong>CAGR calculator</strong> if you made a one-time lump-sum investment. If you are doing a monthly Mutual Fund SIP, you must use an <a href="/xirr-calculator-mutual-funds/">XIRR Calculator</a> because the timing of your varied cash flows completely changes the math.</p>
    </article>
  </main>

  <style>
    .calc-page-wrapper {
      max-width: 680px;
      margin: 0 auto 2rem;
    }

    .calc-result-hero {
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      padding: 3rem 2rem;
      text-align: center;
      margin-bottom: 2rem;
      background: linear-gradient(135deg, rgba(99,102,241,0.08) 0%, rgba(139,92,246,0.02) 100%);
    }

    .calc-result-hero > p:first-child {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 0.75rem;
    }

    .calc-result-hero #cagr-result {
      font-size: 4.5rem;
      font-weight: 700;
      font-family: var(--font-heading);
      background: linear-gradient(135deg, var(--primary-glow), #c084fc);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      margin: 0 0 0.5rem;
      line-height: 1.1;
    }

    .calc-result-hero > p:nth-of-type(2) {
      font-size: 1rem;
      color: var(--text-muted);
    }

    .calc-inputs-panel {
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 1.5rem;
    }

    .calc-inputs-panel > p {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 2rem;
    }

    .calc-field {
      margin-bottom: 2.5rem;
    }

    .calc-field:last-child {
      margin-bottom: 0;
    }

    .calc-field-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .calc-field-header label {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-head);
    }

    .calc-field-value {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-muted);
    }

    .calc-field-value input[type="number"] {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 8px;
      padding: 0.5rem 0.75rem;
      color: var(--text-head);
      font-size: 1.1rem;
      font-weight: 700;
      width: 140px;
      text-align: right;
    }

    .calc-field-value input[type="number"]:first-child {
      width: 80px;
    }

    .calc-field input[type="range"] {
      width: 100%;
      accent-color: var(--primary);
      cursor: pointer;
      height: 6px;
    }

    .calc-chart-panel {
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .calc-chart-panel > p {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1.5rem;
      text-align: center;
    }

    #cagr-chart {
      width: 100%;
      height: auto;
      display: block;
    }

    .calc-chart-legend {
      display: flex;
      justify-content: center;
      gap: 3rem;
      margin-top: 1rem;
      font-size: 0.85rem;
    }

    .calc-chart-legend span {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-muted);
    }

    .calc-chart-legend span span {
      width: 16px;
      height: 3px;
      border-radius: 2px;
      display: inline-block;
      background: #6366f1;
    }

    .calc-chart-legend span:nth-child(2) span {
      background: #34d399;
    }

    .calc-stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 3rem;
    }

    .calc-stats-grid .glass-panel {
      text-align: center;
      padding: 1.5rem;
    }

    .calc-stats-grid .glass-panel p:first-child {
      font-size: 0.7rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-bottom: 0.5rem;
    }

    .calc-stats-grid .glass-panel p:last-child {
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--text-head);
      margin: 0;
    }

    .calc-stats-grid .glass-panel:nth-child(2) p:last-child {
      color: #34d399;
    }

    .calc-stats-grid .glass-panel:nth-child(3) {
      border-color: rgba(99,102,241,0.2);
    }

    .calc-stats-grid .glass-panel:nth-child(3) p:last-child {
      color: #818cf8;
    }

    .calc-cta {
      text-align: center;
      margin-bottom: 4rem;
    }

    .calc-cta .btn {
      padding: 1rem 2.5rem;
      font-size: 1.1rem;
    }

    .calc-cta p {
      color: var(--text-muted);
      font-size: 0.85rem;
      margin-top: 0.75rem;
    }

    @media (max-width: 768px) {
      .calc-result-hero {
        padding: 2rem 1rem;
      }

      .calc-result-hero #cagr-result {
        font-size: 2.5rem;
      }

      .calc-inputs-panel {
        padding: 1.5rem;
      }

      .calc-field-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .calc-field-value {
        width: 100%;
        justify-content: flex-end;
      }

      .calc-field-value input[type="number"] {
        flex: 1;
        max-width: 160px;
      }

      .calc-stats-grid {
        grid-template-columns: 1fr 1fr;
      }

      .calc-stats-grid .glass-panel:last-child {
        grid-column: 1 / -1;
      }
    }
  </style>

  <script>
    function calcCAGR() {
      const P = parseFloat(document.getElementById('initial').value) || 0;
      const F = parseFloat(document.getElementById('final').value) || 0;
      const n = parseFloat(document.getElementById('years').value) || 1;

      const absReturn = P > 0 ? ((F - P) / P) * 100 : 0;
      const cagr = P > 0 && n > 0 ? (Math.pow(F / P, 1 / n) - 1) * 100 : 0;

      document.getElementById('cagr-result').textContent = cagr.toFixed(2) + '%';
      document.getElementById('cagr-years').textContent = n;
      document.getElementById('stat-initial').textContent = '₹' + P.toLocaleString('en-IN');
      document.getElementById('stat-abs').textContent = (absReturn >= 0 ? '+' : '') + absReturn.toFixed(1) + '%';
      document.getElementById('stat-cagr').textContent = cagr.toFixed(2) + '%';

      drawCAGRChart(P, F, n);
    }

    function drawCAGRChart(P, F, years) {
      const svg = document.getElementById('cagr-chart');
      const W = 640, H = 200, PAD = 30;
      const maxVal = Math.max(F, P * 2);
      const pts = [];
      for (let y = 0; y <= years; y++) {
        const val = P * Math.pow(F / P, y / years);
        pts.push({
          x: PAD + (y / years) * (W - 2 * PAD),
          y: H - PAD - ((val / maxVal) * (H - 2 * PAD))
        });
      }
      const toPath = (arr) => arr.map((p, i) => i === 0 ? `M ${p.x} ${p.y}` : `L ${p.x} ${p.y}`).join(' ');
      const toFill = (arr) => `M ${arr[0].x} ${H - PAD} ` + arr.map(p => `L ${p.x} ${p.y}`).join(' ') + ` L ${arr[arr.length-1].x} ${H - PAD} Z`;

      svg.innerHTML = `
        <defs>
          <linearGradient id="gCAGR" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#818cf8" stop-opacity="0.2"/>
            <stop offset="100%" stop-color="#818cf8" stop-opacity="0.02"/>
          </linearGradient>
        </defs>
        <line x1="${PAD}" y1="${H-PAD}" x2="${W-PAD}" y2="${H-PAD}" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
        <line x1="${PAD}" y1="${PAD}" x2="${PAD}" y2="${H-PAD}" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
        <text x="${PAD-4}" y="${PAD+4}" text-anchor="end" fill="#6b7280" font-size="10">₹${(maxVal/100000).toFixed(0)}L</text>
        <text x="${PAD-4}" y="${H-PAD+4}" text-anchor="end" fill="#6b7280" font-size="10">₹0</text>
        <path d="${toFill(pts)}" fill="url(#gCAGR)"/>
        <path d="${toPath(pts)}" fill="none" stroke="#818cf8" stroke-width="2.5"/>
        <circle cx="${pts[pts.length-1].x}" cy="${pts[pts.length-1].y}" r="5" fill="#818cf8"/>
        <text x="${pts[pts.length-1].x-6}" y="${pts[pts.length-1].y-10}" text-anchor="end" fill="#818cf8" font-size="11" font-weight="600">₹${Math.round(F).toLocaleString('en-IN')}</text>
        <text x="${pts[0].x-6}" y="${pts[0].y+16}" text-anchor="end" fill="#6366f1" font-size="11" font-weight="600">₹${Math.round(P).toLocaleString('en-IN')}</text>
      `;
    }

    document.addEventListener('DOMContentLoaded', function() {
      ['initial', 'final', 'years'].forEach(function(id) {
        const inp = document.getElementById(id);
        const slider = document.getElementById(id + '-slider');
        inp.addEventListener('input', function() { slider.value = inp.value; calcCAGR(); });
        slider.addEventListener('input', function() { inp.value = slider.value; calcCAGR(); });
      });
      calcCAGR();
    });
  </script>

</Layout>
