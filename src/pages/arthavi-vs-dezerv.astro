        "@type": "Review",
        "reviewRating": {"@type": "Rating", "ratingValue": "4"},
        "author": {"@type": "Person", "name": "Sanjay R."},
        "reviewBody": "Want to understand my own portfolio, not just hand it off. Arthavi gives me the visibility I need without the high fees of a wealth manager."
      }]
    })} breadcrumb={{
      items: [
        { name: "Home", url: "https://arthavi.com/" },
        { name: "Compare", url: "https://arthavi.com/arthavi-vs-dezerv" }
      ]
