---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Page Not Found - Arthavi",
  description: "",
};
---
<Layout title={seo.title} description={seo.description}  >

    

    <main class="container error-page">
        <div class="error-code fade-in">404</div>
        <h1 class="error-msg fade-in delay-100">Oops! The page you're looking for doesn't exist.</h1>
        <p class="text-muted fade-in delay-100" style="margin-bottom: 3rem;">It looks like the link might be broken or
            the page has moved.</p>
        <a href="/" class="btn btn-primary fade-in delay-200">Go Back Home</a>
    </main>

    
    

</Layout>
