---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "PPF Tracker India — Public Provident Fund Balance & Interest | Arthavi",
  description: "Track your Public Provident Fund (PPF) account balance, annual deposits, 7.1% tax-free interest, and 15-year maturity schedule in one dashboard on Arthavi.",
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Arthavi PPF Tracker",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
      "description": "Track Public Provident Fund (PPF) balances, annual ₹1.5L 80C contributions, accrued interest, and maturity timeline alongside family wealth."
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does Arthavi track PPF interest?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Arthavi tracks your financial year contributions, applying government-notified quarterly PPF interest rates (currently 7.1% p.a.) compounded annually, calculating your exact tax-free maturity accumulation."
          }
        },
        {
          "@type": "Question",
          "name": "Can I track PPF accounts for family members?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. You can track individual PPF accounts for Self, Spouse, and Minor Children under one master family account."
          }
        }
      ]
    }
  ]
});
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords="ppf tracker india, public provident fund tracker, ppf balance tracker, track ppf account, ppf interest calculator india, post office ppf tracker"
  schema={schema}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "PPF Tracker", url: "https://arthavi.com/ppf-tracker/" }
    ]
  }}
>

<main style="padding-top: 7rem; padding-bottom: 5rem;">
  <section style="padding-top: 1rem; position: relative; z-index: 2;">
    <div class="container">

      <div class="section-header text-center fade-in" style="margin-bottom: 3.5rem;">
        <span style="display:inline-block; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); color: #34d399; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 100px; margin-bottom: 1rem;">Tax-Free Fixed Income · Section 80C</span>
        <h1 class="heading-xl" style="margin-bottom: 1rem;">PPF (Public Provident Fund) Tracker India</h1>
        <p style="max-width: 720px; margin: 0 auto; color: var(--text-muted); font-size: 1.15rem; line-height: 1.6;">
          Consolidate your SBI, Post Office, or private bank PPF accounts into your household net worth. Track annual deposits, compounding interest, and 15-year maturity milestones.
        </p>
        <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 0.9rem 2rem;">Track PPF Free</a>
          <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 0.9rem 2rem;">Try Demo</a>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.8rem; margin-bottom: 4rem;">
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">🛡️</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">EEE Tax-Free Wealth</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Track your Exempt-Exempt-Exempt corpus. See your annual ₹1.5 Lakh Section 80C contributions and tax-free interest compounding without manual Excel math.
          </p>
        </div>
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">⏳</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">15-Year Maturity Schedule</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Timeline view of active block years, 5-year extension eligibility, partial withdrawal windows, and loan against PPF limits.
          </p>
        </div>
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">👨‍👩‍👧</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">Minor &amp; Family Accounts</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">
            Log separate PPF accounts for your spouse and minor children. See household tax-free savings pooled into your unified net worth.
          </p>
        </div>
      </div>

      <div style="max-width: 860px; margin: 0 auto 4rem;">
        <h2 style="font-size: 1.75rem; margin-bottom: 2rem; text-align: center;">Frequently Asked Questions</h2>
        <div style="display: flex; flex-direction: column; gap: 1.5rem;">
          <div class="glass-panel" style="padding: 1.8rem; border-radius: 14px;">
            <h3 style="margin-top: 0; font-size: 1.1rem; color: var(--text-head);">How does Arthavi track PPF?</h3>
            <p style="color: var(--text-muted); margin-bottom: 0; line-height: 1.6;">You enter opening balance, account start year, and annual deposit amounts. Arthavi applies government interest rates and projects the maturity accumulation.</p>
          </div>
          <div class="glass-panel" style="padding: 1.8rem; border-radius: 14px;">
            <h3 style="margin-top: 0; font-size: 1.1rem; color: var(--text-head);">Is PPF combined with EPF and VPF in Arthavi?</h3>
            <p style="color: var(--text-muted); margin-bottom: 0; line-height: 1.6;">Yes. Arthavi groups PPF, EPF, VPF, and NPS under retirement and long-term debt assets in your asset allocation breakdown.</p>
          </div>
        </div>
      </div>

      <div style="text-align: center; padding: 2rem 0 3rem;">
        <h2 style="margin-bottom: 1rem;">Track your long-term tax-free savings</h2>
        <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem; margin-right: 1rem;">Start Tracking Free</a>
        <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Try Demo</a>
      </div>

      <nav style="max-width: 860px; margin: 0 auto; padding: 1.5rem; border-radius: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06);">
        <h3 style="font-size: 1rem; margin-bottom: 1rem;">Related trackers</h3>
        <ul style="display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; list-style: none; padding: 0;">
          <li><a href="/fixed-deposit-tracker/">Fixed Deposit Tracker</a></li>
          <li><a href="/rd-tracker/">Recurring Deposit Tracker</a></li>
          <li><a href="/net-worth-tracker-india/">Net Worth Tracker India</a></li>
          <li><a href="/family-portfolio-tracker/">Family Portfolio Tracker</a></li>
        </ul>
      </nav>

    </div>
  </section>
</main>

</Layout>
