  .feed-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.82rem;
    color: #6b7a99;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
