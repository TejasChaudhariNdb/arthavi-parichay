      <span>Last updated: <span class="last-upd" id="bm-updated">{lastBuildBM}</span></span>
    </div>
    <div class="feed-table-wrap">
      <table class="feed-table" aria-label="NSE Board Meetings live feed">
        <thead>
          <tr>
            <th>Company</th>
            <th>Board Meeting Date</th>
            <th>Purpose / Agenda</th>
            <th>Published</th>
          </tr>
        </thead>
        <tbody id="bm-body">
          {initialBM.length > 0 ? (
            initialBM.map(item => (
              <tr>
                <td class="company-name">{item.company}</td>
                <td style="font-weight:600;color:#e8edf7;white-space:nowrap">{item.meetDate}</td>
                <td style="font-size:0.85rem;color:#9bacc8;max-width:320px">{item.desc.substring(0, 120)}…</td>
