  .bm-hero h1 {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    font-weight: 700;
    color: #fff;
    max-width: 800px;
    margin: 0 auto 1rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
    position: relative;
  }
  .bm-hero .sub { color: #8daac4; font-size: 1.05rem; max-width: 600px; margin: 0 auto; line-height: 1.6; position: relative; }
  .bm-hero .date-badge {
    display: inline-block; margin-top: 1.25rem;
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
    color: #8daac4; font-size: 0.82rem; padding: 0.4rem 1rem; border-radius: 999px; position: relative;
  }

  .page-wrap { max-width: 1100px; margin: 0 auto; padding: 2.5rem 1.5rem 5rem; }

  /* Tabs for switching between board meetings and financial results */
  .tab-bar {
    display: flex;
    gap: 0;
    background: var(--card-bg, #111827);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 4px;
