                            <td style="padding: 1rem; font-weight: 500;">Privacy</td>
                            <td style="padding: 1rem;">Low (Reads Emails)</td>
                            <td style="padding: 1rem;">High</td>
                            <td style="padding: 1rem; color: var(--text-head); font-weight: bold;">High (Local Parse)
                            </td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td style="padding: 1rem; font-weight: 500;">Automation</td>
                            <td style="padding: 1rem;">High</td>
                            <td style="padding: 1rem;">None</td>
                            <td style="padding: 1rem; color: var(--text-head);">Medium (CAS Upload)</td>
                        </tr>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td style="padding: 1rem; font-weight: 500;">XIRR Calculation</td>
                            <td style="padding: 1rem;">Basic</td>
                            <td style="padding: 1rem;">Manual Formulas</td>
                            <td style="padding: 1rem; color: var(--text-head);">Advanced</td>
                        </tr>
                        <tr>
                            <td style="padding: 1rem; font-weight: 500;">Ads</td>
                            <td style="padding: 1rem;">Yes</td>
                            <td style="padding: 1rem;">No</td>
                            <td style="padding: 1rem; color: var(--text-head);">No</td>
                        </tr>
                    </tbody>
