                                (e.g. INDmoney)</th>
                            <th style="text-align: left; padding: 1rem; color: var(--text-muted);">Excel</th>
                            <th style="text-align: left; padding: 1rem; color: var(--primary);">Arthavi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td style="padding: 1rem; font-weight: 500;">Unified View</td>
                            <td style="padding: 1rem;">Yes</td>
                            <td style="padding: 1rem;">Yes (Manual)</td>
                            <td style="padding: 1rem; color: var(--text-head);">Yes</td>
                        </tr>
