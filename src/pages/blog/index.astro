---
import Layout from '../../layouts/Layout.astro';

const seo = {
  title: "Arthavi Blog — Portfolio Tracking, CAS Guides & Privacy Insights",
  description: "Guides, tutorials, and analysis on mutual fund portfolio tracking, CAS statement imports, family wealth aggregation, and privacy-first investing in India.",
};

const posts = [
  {
    title: "9 Best Online Investment Tracker Tools in India (2026)",
    slug: "/blog/best-online-investment-tracker-india/",
    category: "Portfolio Tracking",
    date: "2026-10-10",
    description: "Compare the best online investment tracker apps in India — stocks, mutual funds, NPS, and net worth in one place. Arthavi ranked #1 for privacy and accuracy."
  },
  {
    title: "Best Way to Track Stocks & Mutual Funds in One Place Safely",
    slug: "/blog/track-stocks-mutual-funds-one-place-safely/",
    category: "Portfolio Tracking",
    date: "2026-04-25",
    description: "Consolidate Zerodha, Groww, CAMS, and KFintech portfolios without handing over broker login credentials or email access."
  },
  {
    title: "Introducing Multi-Profile & Family Wealth Aggregation",
    slug: "/blog/introducing-multi-profile-family-wealth-aggregation/",
    category: "Product Updates",
    date: "2026-06-14",
    description: "Track portfolios for spouse, parents, and children in unified family views with individual member breakdowns."
  },
  {
    title: "Top Ad-Free Portfolio Trackers in India (2026): Stop Selling Your Data",
    slug: "/blog/best-ad-free-portfolio-tracker-india-2026/",
    category: "Privacy & Security",
    date: "2026-05-01",
    description: "Tired of intrusive loan calls and broker ad spam? Discover why privacy-first tracking protects your financial identity."
  },
  {
    title: "Privacy Alert: Why Your Investment App Shouldn't Read Your Emails",
    slug: "/blog/privacy-alert-why-investment-apps-shouldnt-read-emails/",
    category: "Privacy & Security",
    date: "2026-04-20",
    description: "Understand the risks of Gmail scraping by fintech super-apps and why zero-credential CAS upload is the safest path."
  },
  {
    title: "Track Zerodha and Groww Portfolio Together (Without Broker Login)",
    slug: "/blog/track-zerodha-groww-portfolio-together/",
    category: "Portfolio Tracking",
    date: "2026-02-16",
    description: "How to merge holdings across Zerodha Kite and Groww using Consolidated Account Statements."
  },
  {
    title: "How to Download & Analyze Your CAMS/KFintech CAS Statement",
    slug: "/blog/how-to-download-analyze-cams-cas-statement/",
    category: "CAS Guides",
    date: "2026-02-16",
    description: "Step-by-step walkthrough to generate your official CAS PDF and unlock historical transaction analysis."
  },
  {
    title: "A Guide to Importing CAMS/CAS Statements into a Portfolio Tracker",
    slug: "/blog/guide-cams-cas-portfolio-tracker/",
    category: "CAS Guides",
    date: "2026-01-10",
    description: "Everything you need to know about CAS file encryption, password protection, and zero-storage parsing."
  },
  {
    title: "5 Reasons You Should Stop Using Excel for Your Portfolio",
    slug: "/blog/5-reasons-stop-using-excel-portfolio-tracking/",
    category: "Tools & Spreadsheets",
    date: "2026-02-16",
    description: "Why manual spreadsheets break on corporate actions, SIP adjustments, and multi-year XIRR math."
  },
  {
    title: "7 Reasons Why Excel is Bad for Tracking Stocks & Mutual Funds",
    slug: "/blog/excel-vs-portfolio-tracker/",
    category: "Tools & Spreadsheets",
    date: "2026-02-16",
    description: "A deep dive into formula errors, missing live NAV feeds, and the hidden time cost of DIY sheets."
  },
  {
    title: "How to Track Your Spouse & Kids' Portfolio in India",
    slug: "/blog/how-to-track-family-portfolio-india/",
    category: "Family Wealth",
    date: "2026-02-16",
    description: "Best practices for managing PAN-separated accounts while maintaining a single household asset allocation."
  },
  {
    title: "How to Track Family Investment Portfolios in One App",
    slug: "/blog/track-family-investment-portfolio/",
    category: "Family Wealth",
    date: "2026-02-16",
    description: "Simplify tax reporting and net worth tracking across multiple family generations without sharing credentials."
  },
  {
    title: "How to Track Everything in 3 Steps: Mutual Funds, Stocks & Net Worth",
    slug: "/blog/how-to-track-everything-in-3-steps/",
    category: "Portfolio Tracking",
    date: "2026-02-16",
    description: "From CAS download to AI portfolio diagnostics in under three minutes."
  },
  {
    title: "Income Tax Calculator FY 2025-26 Comparison: Old vs New Regime",
    slug: "/blog/income-tax-calculator-2025-26-comparison/",
    category: "Tax & Planning",
    date: "2026-07-24",
    description: "Compare tax slabs, standard deductions, and capital gains exemptions under both tax regimes for FY 2025-26."
  },
  {
    title: "Best HRA Calculator India 2025: Calculate Tax Exemption",
    slug: "/blog/best-hra-calculator-india/",
    category: "Tax & Planning",
    date: "2026-07-24",
    description: "Calculate your House Rent Allowance tax deduction under Section 10(13A) with metro and non-metro salary rules."
  }
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": "https://arthavi.com/blog/#webpage",
      "url": "https://arthavi.com/blog/",
      "name": seo.title,
      "description": seo.description,
      "publisher": {
        "@type": "Organization",
        "name": "Arthavi",
        "url": "https://arthavi.com"
      }
    },
    {
      "@type": "ItemList",
      "itemListElement": posts.map((post, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "url": `https://arthavi.com${post.slug}`,
        "name": post.title
      }))
    }
  ]
});
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical="https://arthavi.com/blog/"
  schema={schema}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "Blog", url: "https://arthavi.com/blog/" }
    ]
  }}
>
  <main class="blog-index-page">
    <div class="container" style="padding-top: calc(var(--header-height) + 3rem); padding-bottom: 5rem;">
      <header class="section-header text-center" style="max-width: 800px; margin: 0 auto 3.5rem auto;">
        <span class="badge" style="display: inline-block; padding: 0.35rem 1rem; border-radius: 999px; background: rgba(56, 189, 248, 0.1); color: #38BDF8; font-weight: 600; font-size: 0.85rem; margin-bottom: 1rem; border: 1px solid rgba(56, 189, 248, 0.2);">
          Guides & Insights
        </span>
        <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #FFF; line-height: 1.2; margin-bottom: 1.25rem;">
          Portfolio Tracking, CAS & Privacy Insights
        </h1>
        <p style="color: #9CA3AF; font-size: 1.15rem; line-height: 1.6;">
          In-depth technical guides, privacy deep-dives, and financial calculation tutorials designed for the thoughtful Indian investor.
        </p>
      </header>

      <div class="blog-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 2rem;">
        {posts.map(post => (
          <article class="glass-panel post-card" style="padding: 2rem; border-radius: 16px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid rgba(255, 255, 255, 0.08); background: rgba(17, 24, 39, 0.6); transition: transform 0.2s, border-color 0.2s;">
            <div>
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #38BDF8; font-weight: 700; background: rgba(56, 189, 248, 0.1); padding: 0.25rem 0.65rem; border-radius: 6px;">
                  {post.category}
                </span>
                <time datetime={post.date} style="color: #6B7280; font-size: 0.85rem;">
                  {new Date(post.date).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h2 style="font-size: 1.3rem; font-weight: 700; color: #FFF; line-height: 1.35; margin-bottom: 0.85rem;">
                <a href={post.slug} style="color: inherit; text-decoration: none;">
                  {post.title}
                </a>
              </h2>
              <p style="color: #9CA3AF; font-size: 0.95rem; line-height: 1.55; margin-bottom: 1.5rem;">
                {post.description}
              </p>
            </div>
            <div>
              <a href={post.slug} style="display: inline-flex; align-items: center; gap: 0.5rem; color: #38BDF8; font-weight: 600; font-size: 0.95rem; text-decoration: none;">
                Read Article <span>→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .post-card:hover {
    transform: translateY(-4px);
    border-color: rgba(56, 189, 248, 0.35) !important;
  }
</style>
