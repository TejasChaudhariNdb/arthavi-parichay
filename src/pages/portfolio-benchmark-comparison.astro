---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Portfolio Benchmark Comparison — Compare Returns vs Nifty 50 | Arthavi",
  description: "Compare your investment portfolio XIRR with NIFTY 50 and NIFTY 500 TRI benchmarks. See if you are generating positive alpha with Arthavi.",
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Arthavi Portfolio Benchmark Comparison",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
      "description": "Benchmark comparison comparing investor cash-flow XIRR with NIFTY 50 TRI and NIFTY 500 TRI total return indices."
    }
  ]
});
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords="portfolio benchmark comparison india, compare portfolio with nifty 50, portfolio alpha, nifty 50 tri tracker"
  schema={schema}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "Benchmark Comparison", url: "https://arthavi.com/portfolio-benchmark-comparison/" }
    ]
  }}
>

<main style="padding-top: 7rem; padding-bottom: 5rem;">
  <section style="padding-top: 1rem; position: relative; z-index: 2;">
    <div class="container">

      <div class="section-header text-center fade-in" style="margin-bottom: 3.5rem;">
        <span style="display:inline-block; background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.3); color: #60a5fa; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 100px; margin-bottom: 1rem;">Benchmark Alpha · NIFTY 50 TRI</span>
        <h1 class="heading-xl" style="margin-bottom: 1rem;">Portfolio Benchmark Comparison</h1>
        <p style="max-width: 720px; margin: 0 auto; color: var(--text-muted); font-size: 1.15rem; line-height: 1.6;">
          Are your active funds and stock picks actually beating a plain index fund? Arthavi compares your true cash-flow return against NIFTY 50 TRI and NIFTY 500 TRI.
        </p>
        <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 0.9rem 2rem;">Compare My Returns</a>
          <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 0.9rem 2rem;">View Demo</a>
        </div>
      </div>

      <div class="glass-panel" style="max-width: 860px; margin: 0 auto 4rem; padding: 2.5rem; border-radius: 16px;">
        <h2 style="font-size: 1.4rem; color: var(--text-head); margin-top: 0;">Why Total Return Index (TRI) matters</h2>
        <p style="color: var(--text-muted); line-height: 1.7;">
          Traditional indices only measure capital appreciation, ignoring dividends. Because mutual funds automatically reinvest dividends, comparing your portfolio with a standard price index gives a misleading sense of outperformance. Arthavi uses official NSE Total Returns Index (TRI) benchmarks for 100% fair evaluation.
        </p>
      </div>

      <div style="text-align: center; padding: 2rem 0 3rem;">
        <h2 style="margin-bottom: 1rem;">Discover your true investment alpha</h2>
        <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem; margin-right: 1rem;">Upload CAS Free</a>
        <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Try Demo</a>
      </div>

    </div>
  </section>
</main>

</Layout>
