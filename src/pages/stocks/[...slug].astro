---
import Layout from '../../layouts/Layout.astro';
import { STOCK_SEED_DATA } from '../../data/stockSeedData';

// Define static paths for all 343 stocks and subpages
export async function getStaticPaths() {
  const paths = [];
  const subroutes = ['', 'share-price', 'financials', 'dividend', 'shareholding-pattern', 'peer-comparison'];

  for (const stock of STOCK_SEED_DATA) {
    for (const sub of subroutes) {
      const slugPath = sub ? `${stock.slug}/${sub}` : stock.slug;
      paths.push({ params: { slug: slugPath }, props: { stockSeed: stock, activeTabProp: sub || 'overview' } });

      if (stock.short_symbol && stock.short_symbol !== stock.slug) {
        const shortPath = sub ? `${stock.short_symbol}/${sub}` : stock.short_symbol;
        paths.push({ params: { slug: shortPath }, props: { stockSeed: stock, activeTabProp: sub || 'overview' } });
      }
    }
  }

  return paths;
}

const { slug: rawSlug } = Astro.params;

// Parse slug parts safely
const slugParts = (rawSlug || '').split('/').filter(Boolean);
const mainIdentifier = slugParts[0] || 'tata-consultancy-services';
const rawTab = slugParts[1] || 'overview';

const validTabs = ['overview', 'share-price', 'financials', 'dividend', 'shareholding-pattern', 'peer-comparison'];
const activeTab = validTabs.includes(rawTab) ? rawTab : 'overview';

// Match seed stock
const seedMatch = STOCK_SEED_DATA.find(s => 
  s.slug.toLowerCase() === mainIdentifier.toLowerCase() || 
  s.short_symbol.toLowerCase() === mainIdentifier.toLowerCase() || 
  s.symbol.toLowerCase() === mainIdentifier.toLowerCase()
) || STOCK_SEED_DATA[0];

const stockName = seedMatch.name;
const stockSymbol = seedMatch.symbol;
const shortSymbol = seedMatch.short_symbol;
const stockSlug = seedMatch.slug;
const stockSector = seedMatch.sector;

const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

let stockData = {
  symbol: stockSymbol,
  slug: stockSlug,
  shortSymbol: shortSymbol,
  name: stockName,
  price: 0,
  currency: 'INR',
  change: 0,
  changePercent: 0,
  company: {
    sector: stockSector,
    industry: `${stockSector} Industry`,
    website: '',
    description: `${stockName} is a leading ${stockSector} company in India.`,
    employees: null,
    address: null,
    phone: null
  },
  fundamentals: {
    marketCap: null,
    pe: null,
    forwardPE: null,
    pb: null,
    roe: null,
    eps: null,
    forwardEPS: null,
    profitMargin: null,
    operatingMargin: null,
    enterpriseValue: null,
    ebitda: null
  },
  performance: {
    high52: null,
    low52: null,
    previousClose: null,
    open: null,
    dayHigh: null,
    dayLow: null,
    targetPrice: null
  },
  ownership: {
    promoter: null,
    fii: null,
    cash: null,
    debt: null,
    debtToEquity: null
  },
  dividend: {
    yield: null,
    rate: null,
    lastDividend: null,
    exDate: null,
    lastSplit: null
  },
  executives: []
};

// Fetch real-time cached data from FastAPI backend
try {
  const res = await fetch(`${apiUrl}/api/public/stocks/${stockSlug}`);
  if (res.ok) {
    const fetchedData = await res.json();
    if (fetchedData && fetchedData.name) {
      stockData = {
        ...stockData,
        ...fetchedData,
        company: { ...stockData.company, ...(fetchedData.company || {}) },
        fundamentals: { ...stockData.fundamentals, ...(fetchedData.fundamentals || {}) },
        performance: { ...stockData.performance, ...(fetchedData.performance || {}) },
        ownership: { ...stockData.ownership, ...(fetchedData.ownership || {}) },
        dividend: { ...stockData.dividend, ...(fetchedData.dividend || {}) },
        executives: fetchedData.executives || []
      };
    }
  }
} catch (err) {
  console.warn(`[Astro Build] Backend API un-reachable at ${apiUrl}, using fallback:`, err);
}

// Formatted values
const formatCurrency = (val: number | null | undefined) => {
  if (val === null || val === undefined) return 'N/A';
  if (val >= 1e12) return `₹${(val / 1e12).toFixed(2)} Lakh Cr`;
  if (val >= 1e7) return `₹${(val / 1e7).toFixed(2)} Cr`;
  return `₹${val.toLocaleString('en-IN')}`;
};

const formatPercent = (val: number | null | undefined) => {
  if (val === null || val === undefined) return 'N/A';
  return `${val > 0 ? '+' : ''}${val.toFixed(2)}%`;
};

// Related stocks in same sector
const relatedStocks = STOCK_SEED_DATA
  .filter(s => s.sector === stockSector && s.slug !== stockSlug)
  .slice(0, 5);

// Deterministic AI Insight Generator
const valPe = stockData.fundamentals.pe || 25;
const valuationInsight = valPe < 20
  ? `${stockName} currently trades at an attractive P/E ratio of ${valPe}, reflecting a discounted valuation compared to broader sector averages.`
  : valPe < 35
  ? `${stockName} trades at a balanced P/E of ${valPe}, reflecting strong institutional market trust and consistent compound returns.`
  : `${stockName} commands a premium valuation with a P/E of ${valPe}, supported by high market dominance and profitability expectations.`;

const profitabilityInsight = `${stockName} maintains high capital efficiency with an ROE of ${stockData.fundamentals.roe}% and operating margins of ${stockData.fundamentals.operatingMargin}%, demonstrating robust cash generation capabilities.`;

const dividendInsight = stockData.dividend.yield
  ? `${stockName} offers a competitive dividend yield of ${stockData.dividend.yield}% with an annual dividend rate of ₹${stockData.dividend.rate}, making it attractive for passive income investors.`
  : `${stockName} prioritizes capital reinvestment into business expansion over aggressive dividend payouts.`;

// Dynamic Meta Titles & Descriptions based on active tab
let metaTitle = `${stockName} (${shortSymbol.toUpperCase()}) Share Price Today | Fundamentals & PE Ratio | Arthavi`;
let metaDescription = `Track ${stockName} (${shortSymbol.toUpperCase()}) share price, valuation metrics, P/E ratio, market cap, dividend yield, company profile, and financial performance on Arthavi.`;

if (activeTab === 'financials') {
  metaTitle = `${stockName} Financials, P/E Ratio & Valuation Metrics | Arthavi`;
  metaDescription = `Comprehensive financial analysis for ${stockName} including P/E ratio, ROE, profit margins, balance sheet metrics, cash flows, and EV/EBITDA multiples.`;
} else if (activeTab === 'dividend') {
  metaTitle = `${stockName} Dividend History, Yield & Ex-Date | Arthavi`;
  metaDescription = `Track ${stockName} dividend yield, payout rate, ex-dividend dates, split history, and income performance metrics on Arthavi.`;
} else if (activeTab === 'shareholding-pattern') {
  metaTitle = `${stockName} Shareholding Pattern, Promoter & FII Holding | Arthavi`;
  metaDescription = `Analyze ${stockName} ownership structure including promoter holdings, FII/DII institutional stake, cash reserves, and debt-to-equity metrics.`;
} else if (activeTab === 'peer-comparison') {
  metaTitle = `${stockName} Peer Comparison & Sector Competitors | Arthavi`;
  metaDescription = `Compare ${stockName} against top ${stockSector} competitors on P/E ratio, ROE, market capitalization, margins, and dividend yields.`;
}

// Canonical URL
const canonicalUrl = `https://arthavi.com/stocks/${stockSlug}/${activeTab !== 'overview' ? activeTab + '/' : ''}`;

// Schema JSON-LD
const schemaGraph = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Corporation",
      "@id": `https://arthavi.com/stocks/${stockSlug}/#corporation`,
      "name": stockName,
      "tickerSymbol": stockSymbol,
      "description": stockData.company.description,
      "url": stockData.company.website,
      "numberOfEmployees": stockData.company.employees
    },
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": metaTitle,
      "description": metaDescription
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `What is ${stockName} share price today?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${stockName} (${shortSymbol.toUpperCase()}) is currently trading around ₹${stockData.price.toLocaleString('en-IN')}.`
          }
        },
        {
          "@type": "Question",
          "name": `What is ${stockName} P/E ratio?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${stockName} currently has a P/E ratio of ${stockData.fundamentals.pe || 'N/A'}.`
          }
        },
        {
          "@type": "Question",
          "name": `What is ${stockName} market capitalization?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${stockName} has a market capitalization of ${formatCurrency(stockData.fundamentals.marketCap)}.`
          }
        },
        {
          "@type": "Question",
          "name": `What sector does ${stockName} belong to?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `${stockName} operates in the ${stockSector} sector.`
          }
        }
      ]
    }
  ]
});

// Breadcrumbs
const breadcrumb = {
  items: [
    { name: "Home", url: "https://arthavi.com/" },
    { name: "Stocks", url: "https://arthavi.com/stocks/" },
    { name: stockName, url: `https://arthavi.com/stocks/${stockSlug}/` }
  ]
};
---

<Layout 
  title={metaTitle} 
  description={metaDescription} 
  canonical={canonicalUrl}
  schema={schemaGraph}
  breadcrumb={breadcrumb}
>
  <!-- Sticky Header Bar on Scroll -->
  <div id="sticky-stock-bar" class="sticky-stock-bar hidden">
    <div class="container sticky-bar-inner">
      <div class="sticky-bar-info">
        <span class="sticky-bar-name">{stockName}</span>
        <span class="sticky-bar-symbol">{shortSymbol.toUpperCase()}</span>
      </div>
      <div class="sticky-bar-price">
        <span class="sticky-price-value">₹{stockData.price.toFixed(2)}</span>
        <span class={`sticky-price-change ${stockData.change >= 0 ? 'text-green' : 'text-red'}`}>
          {formatPercent(stockData.changePercent)}
        </span>
      </div>
      <a href="https://app.arthavi.com/register" class="btn btn-primary btn-sm">Track in Portfolio</a>
    </div>
  </div>

  <main class="stock-page-container">
    <!-- Breadcrumb Navigation (Clear of fixed header with top margin) -->
    <nav class="container breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li><span class="crumb-separator">/</span></li>
        <li><a href="/stocks/">Stocks</a></li>
        <li><span class="crumb-separator">/</span></li>
        <li class="crumb-active" aria-current="page">{stockName}</li>
      </ol>
      <div class="meta-timestamps">
        <span>⏱ 3 min read</span>
        <span class="meta-dot">·</span>
        <span>Updated Today</span>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="container stock-hero">
      <div class="hero-main-card glass-panel">
        <div class="hero-top-row">
          <div>
            <div class="badge-row">
              <span class="sector-badge">{stockSector}</span>
              <span class="ticker-badge">NSE: {shortSymbol.toUpperCase()}</span>
            </div>
            <h1 class="stock-title">{stockName}</h1>
            <p class="stock-subtitle">{stockData.company.industry}</p>
          </div>

          <div class="price-box text-right">
            <div class="main-price">
              ₹{stockData.price.toLocaleString('en-IN', { minimumFractionDigits: 2 })}
              <span class="price-currency">{stockData.currency}</span>
            </div>
            <div class={`price-change-pill ${stockData.change >= 0 ? 'bg-green-soft text-green' : 'bg-red-soft text-red'}`}>
              {stockData.change >= 0 ? '▲' : '▼'} ₹{Math.abs(stockData.change).toFixed(2)} ({formatPercent(stockData.changePercent)})
            </div>
          </div>
        </div>

        <!-- Action Bar -->
        <div class="hero-actions-row">
          <div class="action-buttons">
            <a href={`/compare/${stockSlug}-vs-infosys/`} class="btn btn-secondary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
              Compare
            </a>
            <a href="https://app.arthavi.com/register" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              Add to Portfolio
            </a>
          </div>

          <div class="utility-buttons">
            <button type="button" id="copy-symbol-btn" class="icon-btn" title="Copy Stock Symbol" data-symbol={shortSymbol.toUpperCase()}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span id="copy-toast" class="btn-tooltip">Copied!</span>
            </button>
            <button type="button" id="share-page-btn" class="icon-btn" title="Share Page">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Subpage Navigation Tabs (Interactive & Deep-linkable) -->
    <section class="container tab-nav-section">
      <div class="tab-scroll-container">
        <a href={`/stocks/${stockSlug}/`} class={`tab-link ${activeTab === 'overview' ? 'is-active' : ''}`} data-tab-name="overview">Overview</a>
        <a href={`/stocks/${stockSlug}/share-price/`} class={`tab-link ${activeTab === 'share-price' ? 'is-active' : ''}`} data-tab-name="share-price">Share Price</a>
        <a href={`/stocks/${stockSlug}/financials/`} class={`tab-link ${activeTab === 'financials' ? 'is-active' : ''}`} data-tab-name="financials">Financials & P/E</a>
        <a href={`/stocks/${stockSlug}/dividend/`} class={`tab-link ${activeTab === 'dividend' ? 'is-active' : ''}`} data-tab-name="dividend">Dividends</a>
        <a href={`/stocks/${stockSlug}/shareholding-pattern/`} class={`tab-link ${activeTab === 'shareholding-pattern' ? 'is-active' : ''}`} data-tab-name="shareholding-pattern">Shareholding</a>
        <a href={`/stocks/${stockSlug}/peer-comparison/`} class={`tab-link ${activeTab === 'peer-comparison' ? 'is-active' : ''}`} data-tab-name="peer-comparison">Peer Comparison</a>
      </div>
    </section>

    <!-- Quick Stats Grid -->
    <section class="container section-space tab-content-block" data-tabs="overview,share-price,financials">
      <h2 class="section-title">Quick Fundamentals</h2>
      <div class="quick-stats-grid">
        <div class="stat-card glass-panel">
          <span class="stat-label">Market Cap</span>
          <span class="stat-value">{formatCurrency(stockData.fundamentals.marketCap)}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="stat-label">P/E Ratio</span>
          <span class="stat-value">{stockData.fundamentals.pe || 'N/A'}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="stat-label">P/B Ratio</span>
          <span class="stat-value">{stockData.fundamentals.pb || 'N/A'}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="stat-label">ROE</span>
          <span class="stat-value">{stockData.fundamentals.roe ? `${stockData.fundamentals.roe}%` : 'N/A'}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="stat-label">Dividend Yield</span>
          <span class="stat-value">{stockData.dividend.yield ? `${stockData.dividend.yield}%` : 'N/A'}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="stat-label">52W High</span>
          <span class="stat-value">{stockData.performance.high52 ? `₹${stockData.performance.high52}` : 'N/A'}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="stat-label">52W Low</span>
          <span class="stat-value">{stockData.performance.low52 ? `₹${stockData.performance.low52}` : 'N/A'}</span>
        </div>
        <div class="stat-card glass-panel">
          <span class="stat-label">EPS (TTM)</span>
          <span class="stat-value">{stockData.fundamentals.eps ? `₹${stockData.fundamentals.eps}` : 'N/A'}</span>
        </div>
      </div>
    </section>

    <!-- Performance & Valuation Section -->
    <section class="container section-space tab-content-block" data-tabs="overview,share-price,financials">
      <div class="card-grid-2">
        <div class="glass-panel content-box">
          <h3 class="box-title">Price Performance</h3>
          <div class="metric-row">
            <span>Previous Close</span>
            <strong>{stockData.performance.previousClose ? `₹${stockData.performance.previousClose}` : 'N/A'}</strong>
          </div>
          <div class="metric-row">
            <span>Open</span>
            <strong>{stockData.performance.open ? `₹${stockData.performance.open}` : 'N/A'}</strong>
          </div>
          <div class="metric-row">
            <span>Day High / Low</span>
            <strong>{stockData.performance.dayHigh && stockData.performance.dayLow ? `₹${stockData.performance.dayHigh} / ₹${stockData.performance.dayLow}` : 'N/A'}</strong>
          </div>
          <div class="metric-row">
            <span>Analyst Target Price</span>
            <strong>{stockData.performance.targetPrice ? `₹${stockData.performance.targetPrice}` : 'N/A'}</strong>
          </div>

          <!-- 52-Week Range Bar -->
          {stockData.performance.high52 && stockData.performance.low52 && (
            <div class="range-box">
              <div class="range-labels">
                <span>52W Low: ₹{stockData.performance.low52}</span>
                <span>52W High: ₹{stockData.performance.high52}</span>
              </div>
              <div class="range-track">
                <div class="range-fill" style={`width: ${Math.min(Math.max(((stockData.price - stockData.performance.low52) / (stockData.performance.high52 - stockData.performance.low52) * 100), 5), 100).toFixed(1)}%`}></div>
              </div>
            </div>
          )}
        </div>

        <!-- Valuation Card + AI Insight -->
        <div class="glass-panel content-box">
          <h3 class="box-title">Valuation Analysis</h3>
          <div class="ai-insight-box">
            <span class="ai-sparkle">✨ Valuation Insight</span>
            <p>{valuationInsight}</p>
          </div>

          <div class="metrics-two-col">
            <div class="mini-metric">
              <span>Forward P/E</span>
              <strong>{stockData.fundamentals.forwardPE || 'N/A'}</strong>
            </div>
            <div class="mini-metric">
              <span>Enterprise Value</span>
              <strong>{formatCurrency(stockData.fundamentals.enterpriseValue)}</strong>
            </div>
            <div class="mini-metric">
              <span>P/B Ratio</span>
              <strong>{stockData.fundamentals.pb || 'N/A'}</strong>
            </div>
            <div class="mini-metric">
              <span>Forward EPS</span>
              <strong>{stockData.fundamentals.forwardEPS ? `₹${stockData.fundamentals.forwardEPS}` : 'N/A'}</strong>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Profitability & Ownership -->
    <section class="container section-space tab-content-block" data-tabs="overview,financials,shareholding-pattern">
      <div class="card-grid-2">
        <!-- Profitability Box -->
        <div class="glass-panel content-box">
          <h3 class="box-title">Profitability & Margins</h3>
          <div class="ai-insight-box">
            <span class="ai-sparkle">✨ Profitability Insight</span>
            <p>{profitabilityInsight}</p>
          </div>

          <div class="metric-row">
            <span>Return on Equity (ROE)</span>
            <strong>{stockData.fundamentals.roe ? `${stockData.fundamentals.roe}%` : 'N/A'}</strong>
          </div>
          <div class="metric-row">
            <span>Profit Margin</span>
            <strong>{stockData.fundamentals.profitMargin ? `${stockData.fundamentals.profitMargin}%` : 'N/A'}</strong>
          </div>
          <div class="metric-row">
            <span>Operating Margin</span>
            <strong>{stockData.fundamentals.operatingMargin ? `${stockData.fundamentals.operatingMargin}%` : 'N/A'}</strong>
          </div>
        </div>

        <!-- Ownership & Balance Sheet Box -->
        <div class="glass-panel content-box">
          <h3 class="box-title">Shareholding & Balance Sheet</h3>
          <div class="metric-row">
            <span>Promoter Holding</span>
            <strong>{stockData.ownership.promoter ? `${stockData.ownership.promoter}%` : 'N/A'}</strong>
          </div>
          <div class="metric-row">
            <span>FII / Institutional Holding</span>
            <strong>{stockData.ownership.fii ? `${stockData.ownership.fii}%` : 'N/A'}</strong>
          </div>
          <div class="metric-row">
            <span>Total Cash</span>
            <strong>{formatCurrency(stockData.ownership.cash)}</strong>
          </div>
          <div class="metric-row">
            <span>Debt-to-Equity Ratio</span>
            <strong>{stockData.ownership.debtToEquity !== null ? stockData.ownership.debtToEquity : 'N/A'}</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- Dividends Section -->
    <section class="container section-space tab-content-block" data-tabs="overview,dividend">
      <div class="glass-panel content-box">
        <h3 class="box-title">Dividend Information</h3>
        <div class="ai-insight-box">
          <span class="ai-sparkle">✨ Dividend Insight</span>
          <p>{dividendInsight}</p>
        </div>

        <div class="dividend-grid">
          <div class="div-card">
            <span>Dividend Yield</span>
            <strong>{stockData.dividend.yield ? `${stockData.dividend.yield}%` : 'N/A'}</strong>
          </div>
          <div class="div-card">
            <span>Annual Dividend Rate</span>
            <strong>{stockData.dividend.rate ? `₹${stockData.dividend.rate}` : 'N/A'}</strong>
          </div>
          <div class="div-card">
            <span>Last Ex-Dividend Date</span>
            <strong>{stockData.dividend.exDate || 'N/A'}</strong>
          </div>
          <div class="div-card">
            <span>Last Split Factor</span>
            <strong>{stockData.dividend.lastSplit || 'N/A'}</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- Company Profile & Key Executives -->
    <section class="container section-space tab-content-block" data-tabs="overview">
      <div class="glass-panel content-box">
        <h3 class="box-title">Company Profile</h3>
        <p class="company-desc">{stockData.company.description}</p>

        <div class="profile-details-grid">
          <div><strong>Website:</strong> {stockData.company.website ? <a href={stockData.company.website} target="_blank" rel="noopener noreferrer">{stockData.company.website}</a> : 'N/A'}</div>
          <div><strong>Employees:</strong> {stockData.company.employees ? stockData.company.employees.toLocaleString('en-IN') : 'N/A'}</div>
          <div><strong>Sector:</strong> {stockData.company.sector}</div>
          <div><strong>Industry:</strong> {stockData.company.industry}</div>
          <div><strong>Headquarters:</strong> {stockData.company.address || 'N/A'}</div>
          <div><strong>Phone:</strong> {stockData.company.phone || 'N/A'}</div>
        </div>

        {stockData.executives.length > 0 && (
          <div>
