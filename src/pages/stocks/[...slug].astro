    animation: pulse-animation 2s infinite;
  }
  @keyframes pulse-animation {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
</style>

<script define:vars={{ apiUrl, stockSlug }}>
  // Copy stock symbol functionality
  const copyBtn = document.getElementById('copy-symbol-btn');
  const copyToast = document.getElementById('copy-toast');

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const sym = copyBtn.getAttribute('data-symbol') || '';
      navigator.clipboard.writeText(sym).then(() => {
        if (copyToast) {
          copyToast.style.display = 'block';
          setTimeout(() => { copyToast.style.display = 'none'; }, 2000);
        }
      });
    });
  }

  // Native share functionality
  const shareBtn = document.getElementById('share-page-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      if (navigator.share) {
        navigator.share({
          title: document.title,
          url: window.location.href
        });
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert('URL copied to clipboard!');
      }
    });
  }

  // Scroll listener for Sticky Stock Bar
  const stickyBar = document.getElementById('sticky-stock-bar');
  window.addEventListener('scroll', () => {
    if (stickyBar) {
      if (window.scrollY > 280) {
        stickyBar.classList.remove('hidden');
      } else {
        stickyBar.classList.add('hidden');
      }
    }
  });

  // Client-side real-time stock data hydration
  (async function hydrateStockData() {
    try {
      const backendUrl = apiUrl || (window.location.hostname === 'localhost' ? 'http://localhost:8000' : 'https://setu2.arthavi.com');
      const res = await fetch(`${backendUrl}/api/public/stocks/${stockSlug}`);
      if (!res.ok) return;
      const data = await res.json();
      if (!data || !data.price) return;

      // 1. Update prices (Main & Sticky)
      const priceEls = document.querySelectorAll('.main-price, .sticky-price-value');
      priceEls.forEach(el => {
        if (el.classList.contains('main-price')) {
          el.innerHTML = `₹${data.price.toLocaleString('en-IN', { minimumFractionDigits: 2 })} <span class="price-currency">${data.currency || 'INR'}</span>`;
        } else {
          el.textContent = `₹${data.price.toFixed(2)}`;
        }
      });

      // 2. Update price change pills
      const isPos = data.change >= 0;
      const changePill = document.querySelector('.price-change-pill');
      if (changePill && data.change !== undefined) {
        changePill.className = `price-change-pill ${isPos ? 'bg-green-soft text-green' : 'bg-red-soft text-red'}`;
        changePill.textContent = `${isPos ? '▲' : '▼'} ₹${Math.abs(data.change).toFixed(2)} (${isPos ? '+' : ''}${data.changePercent.toFixed(2)}%)`;
      }

      const stickyChange = document.querySelector('.sticky-price-change');
      if (stickyChange && data.changePercent !== undefined) {
        stickyChange.className = `sticky-price-change ${isPos ? 'text-green' : 'text-red'}`;
        stickyChange.textContent = `${isPos ? '+' : ''}${data.changePercent.toFixed(2)}%`;
      }

      // 3. Update header timestamp to Live status
      const metaTimestamps = document.querySelector('.meta-timestamps');
      if (metaTimestamps) {
        metaTimestamps.innerHTML = `<span>⏱ 4 min read</span><span class="meta-dot">·</span><span class="live-update-badge"><span class="pulse-dot"></span> Live Updated</span>`;
      }

      // 4. Update fundamental metrics if data-stat elements exist
      const fmtCurr = (val) => {
        if (val === null || val === undefined) return 'N/A';
        if (val >= 1e12) return `₹${(val / 1e12).toFixed(2)} Lakh Cr`;
        if (val >= 1e7) return `₹${(val / 1e7).toFixed(2)} Cr`;
        return `₹${val.toLocaleString('en-IN')}`;
      };

      const setStat = (key, val) => {
        const el = document.querySelector(`[data-stat="${key}"]`);
        if (el && val !== undefined && val !== null) el.textContent = val;
      };

      if (data.fundamentals) {
        setStat('marketCap', fmtCurr(data.fundamentals.marketCap));
        setStat('pe', data.fundamentals.pe ? data.fundamentals.pe.toFixed(2) : 'N/A');
        setStat('pb', data.fundamentals.pb ? data.fundamentals.pb.toFixed(2) : 'N/A');
        setStat('roe', data.fundamentals.roe ? `${data.fundamentals.roe}%` : 'N/A');
        setStat('eps', data.fundamentals.eps ? `₹${data.fundamentals.eps}` : 'N/A');
        setStat('enterpriseValue', fmtCurr(data.fundamentals.enterpriseValue));
      }

      if (data.dividend) {
        setStat('divYield', data.dividend.yield ? `${data.dividend.yield}%` : 'N/A');
      }

      if (data.performance) {
        setStat('high52', data.performance.high52 ? `₹${data.performance.high52}` : 'N/A');
        setStat('low52', data.performance.low52 ? `₹${data.performance.low52}` : 'N/A');
        setStat('previousClose', data.performance.previousClose ? `₹${data.performance.previousClose}` : 'N/A');
        setStat('open', data.performance.open ? `₹${data.performance.open}` : 'N/A');
        setStat('targetPrice', data.performance.targetPrice ? `₹${data.performance.targetPrice}` : 'N/A');
        if (data.performance.dayHigh && data.performance.dayLow) {
          setStat('dayHighLow', `₹${data.performance.dayHigh} / ₹${data.performance.dayLow}`);
        }

        // Update 52-week range bar fill
        if (data.performance.high52 && data.performance.low52 && data.price) {
          const rangeFill = document.querySelector('.range-fill');
          if (rangeFill) {
            const pct = Math.min(Math.max(((data.price - data.performance.low52) / (data.performance.high52 - data.performance.low52) * 100), 5), 100);
            rangeFill.style.width = `${pct.toFixed(1)}%`;
          }
        }
      }
    } catch (err) {
      console.debug('Client live stock hydration notice:', err);
    }
  })();
</script>
