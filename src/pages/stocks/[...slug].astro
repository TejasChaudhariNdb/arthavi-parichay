<script is:inline>
  // Dynamic Tab Filtering and Switching
  function applyActiveTabFilter() {
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    const currentTab = (pathParts.length >= 3 && pathParts[0] === 'stocks') ? pathParts[2] : 'overview';

    // Update tab-link active UI
    document.querySelectorAll('.tab-link').forEach(link => {
      const tabName = link.getAttribute('data-tab-name');
      if (tabName === currentTab) {
        link.classList.add('is-active');
      } else {
        link.classList.remove('is-active');
      }
    });

    // Show/hide sections based on data-tabs attribute
    document.querySelectorAll('.tab-content-block').forEach(block => {
      const allowedTabs = (block.getAttribute('data-tabs') || 'overview').split(',');
      if (currentTab === 'overview' || allowedTabs.includes(currentTab)) {
        block.classList.remove('hidden');
      } else {
        block.classList.add('hidden');
      }
    });
  }

  // Initial tab filter run
  applyActiveTabFilter();

  // Tab click listener for smooth tab toggle without full page reload
  document.querySelectorAll('.tab-link').forEach(link => {
    link.addEventListener('click', (e) => {
      const href = link.getAttribute('href');
      if (href) {
        window.history.pushState({}, '', href);
        applyActiveTabFilter();
      }
    });
  });

  // Handle browser back/forward buttons for tabs
  window.addEventListener('popstate', applyActiveTabFilter);

  // Copy stock symbol functionality
  const copyBtn = document.getElementById('copy-symbol-btn');
  const copyToast = document.getElementById('copy-toast');

  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const sym = copyBtn.getAttribute('data-symbol') || '';
      navigator.clipboard.writeText(sym).then(() => {
        if (copyToast) {
          copyToast.style.display = 'block';
          setTimeout(() => { copyToast.style.display = 'none'; }, 2000);
        }
      });
    });
  }

  // Native share functionality
  const shareBtn = document.getElementById('share-page-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      if (navigator.share) {
        navigator.share({
          title: document.title,
          url: window.location.href
        });
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert('URL copied to clipboard!');
      }
    });
  }

  // Scroll listener for Sticky Stock Bar
  const stickyBar = document.getElementById('sticky-stock-bar');
  window.addEventListener('scroll', () => {
    if (stickyBar) {
      if (window.scrollY > 280) {
        stickyBar.classList.remove('hidden');
      } else {
        stickyBar.classList.add('hidden');
      }
    }
  });

  // Client-side hydration from live FastAPI backend API
  (async function hydrateStockData() {
    const pathParts = window.location.pathname.split('/').filter(Boolean);
    if (pathParts.length >= 2 && pathParts[0] === 'stocks') {
      const stockId = pathParts[1];
      const backendUrl = 'http://localhost:8000';
      try {
        const res = await fetch(`${backendUrl}/api/public/stocks/${stockId}`);
        if (!res.ok) return;
        const data = await res.json();
        if (!data || !data.price) return;

        // Update DOM elements if present
        const priceEls = document.querySelectorAll('.main-price, .sticky-price-value');
        priceEls.forEach(el => {
          if (el.classList.contains('main-price')) {
            el.innerHTML = `₹${data.price.toLocaleString('en-IN', { minimumFractionDigits: 2 })} <span class="price-currency">${data.currency || 'INR'}</span>`;
          } else {
            el.textContent = `₹${data.price.toFixed(2)}`;
          }
        });

        const changePill = document.querySelector('.price-change-pill');
        if (changePill && data.change !== undefined) {
          const isPos = data.change >= 0;
          changePill.className = `price-change-pill ${isPos ? 'bg-green-soft text-green' : 'bg-red-soft text-red'}`;
          changePill.textContent = `${isPos ? '▲' : '▼'} ₹${Math.abs(data.change).toFixed(2)} (${isPos ? '+' : ''}${data.changePercent.toFixed(2)}%)`;
        }

        // Update company description if placeholder
        const descEl = document.querySelector('.company-desc');
        if (descEl && data.company && data.company.description) {
          descEl.textContent = data.company.description;
        }

        // Update quick stats if available
        const statValues = document.querySelectorAll('.quick-stats-grid .stat-value');
        if (statValues.length >= 8 && data.fundamentals) {
          if (data.fundamentals.marketCap) {
            const mc = data.fundamentals.marketCap;
            statValues[0].textContent = mc >= 1e12 ? `₹${(mc / 1e12).toFixed(2)} Lakh Cr` : `₹${(mc / 1e7).toFixed(2)} Cr`;
          }
          if (data.fundamentals.pe) statValues[1].textContent = data.fundamentals.pe;
          if (data.fundamentals.pb) statValues[2].textContent = data.fundamentals.pb;
          if (data.fundamentals.roe) statValues[3].textContent = `${data.fundamentals.roe}%`;
          if (data.dividend && data.dividend.yield) statValues[4].textContent = `${data.dividend.yield}%`;
          if (data.performance && data.performance.high52) statValues[5].textContent = `₹${data.performance.high52}`;
          if (data.performance && data.performance.low52) statValues[6].textContent = `₹${data.performance.low52}`;
          if (data.fundamentals.eps) statValues[7].textContent = `₹${data.fundamentals.eps}`;
        }
      } catch (err) {
        console.debug('Client hydration skipped:', err);
      }
    }
  })();
</script>
