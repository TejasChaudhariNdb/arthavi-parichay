---
import Layout from '../../layouts/Layout.astro';
import { STOCK_SEED_DATA } from '../../data/stockSeedData';

// Define static paths for all 343 stocks and subpages
export async function getStaticPaths() {
  const paths = [];
  const subroutes = ['', 'share-price', 'financials', 'dividend', 'shareholding-pattern', 'peer-comparison'];

  for (const stock of STOCK_SEED_DATA) {
    for (const sub of subroutes) {
      const slugPath = sub ? `${stock.slug}/${sub}` : stock.slug;
      paths.push({ params: { slug: slugPath }, props: { stockSeed: stock, activeTabProp: sub || 'overview' } });

      if (stock.short_symbol && stock.short_symbol !== stock.slug) {
        const shortPath = sub ? `${stock.short_symbol}/${sub}` : stock.short_symbol;
        paths.push({ params: { slug: shortPath }, props: { stockSeed: stock, activeTabProp: sub || 'overview' } });
      }
    }
  }

  return paths;
}

const { slug: rawSlug } = Astro.params;

// Parse slug parts safely
const slugParts = (rawSlug || '').split('/').filter(Boolean);
const mainIdentifier = slugParts[0] || 'tata-consultancy-services';
const rawTab = slugParts[1] || 'overview';

const validTabs = ['overview', 'share-price', 'financials', 'dividend', 'shareholding-pattern', 'peer-comparison'];
const activeTab = validTabs.includes(rawTab) ? rawTab : 'overview';

// Match seed stock
const seedMatch = STOCK_SEED_DATA.find(s => 
  s.slug.toLowerCase() === mainIdentifier.toLowerCase() || 
  s.short_symbol.toLowerCase() === mainIdentifier.toLowerCase() || 
  s.symbol.toLowerCase() === mainIdentifier.toLowerCase()
) || STOCK_SEED_DATA[0];

const stockName = seedMatch.name;
const stockSymbol = seedMatch.symbol;
const shortSymbol = seedMatch.short_symbol;
const stockSlug = seedMatch.slug;
const stockSector = seedMatch.sector;

const apiUrl = import.meta.env.PUBLIC_API_URL || 'https://setu2.arthavi.com';

let stockData = {
  symbol: stockSymbol,
  slug: stockSlug,
  shortSymbol: shortSymbol,
  name: stockName,
  price: 0,
  currency: 'INR',
  change: 0,
  changePercent: 0,
  company: {
    sector: stockSector,
    industry: `${stockSector} Industry`,
    website: '',
    description: `${stockName} is a leading ${stockSector} company in India.`,
    employees: null,
    address: null,
    phone: null
  },
  fundamentals: {
    marketCap: null,
    pe: null,
    forwardPE: null,
    pb: null,
    roe: null,
    eps: null,
    forwardEPS: null,
    profitMargin: null,
    operatingMargin: null,
    enterpriseValue: null,
    ebitda: null
  },
  performance: {
    high52: null,
    low52: null,
    previousClose: null,
    open: null,
    dayHigh: null,
    dayLow: null,
    targetPrice: null
  },
  ownership: {
    promoter: null,
    fii: null,
    cash: null,
    debt: null,
    debtToEquity: null
  },
  dividend: {
    yield: null,
    rate: null,
    lastDividend: null,
    exDate: null,
    lastSplit: null
  },
  executives: []
};

// Fetch real-time cached data from FastAPI backend at build time
try {
  const res = await fetch(`${apiUrl}/api/public/stocks/${stockSlug}`);
  if (res.ok) {
    const fetchedData = await res.json();
    if (fetchedData && fetchedData.name) {
      stockData = {
        ...stockData,
        ...fetchedData,
        company: { ...stockData.company, ...(fetchedData.company || {}) },
        fundamentals: { ...stockData.fundamentals, ...(fetchedData.fundamentals || {}) },
        performance: { ...stockData.performance, ...(fetchedData.performance || {}) },
        ownership: { ...stockData.ownership, ...(fetchedData.ownership || {}) },
        dividend: { ...stockData.dividend, ...(fetchedData.dividend || {}) },
        executives: fetchedData.executives || []
      };
    }
  }
} catch (err) {
  console.warn(`[Astro Build] Backend API un-reachable at ${apiUrl}, using fallback:`, err);
}

// Formatted helper functions
const formatCurrency = (val: number | null | undefined) => {
  if (val === null || val === undefined) return 'N/A';
  if (val >= 1e12) return `₹${(val / 1e12).toFixed(2)} Lakh Cr`;
  if (val >= 1e7) return `₹${(val / 1e7).toFixed(2)} Cr`;
  return `₹${val.toLocaleString('en-IN')}`;
};

const formatPercent = (val: number | null | undefined) => {
  if (val === null || val === undefined) return 'N/A';
  return `${val > 0 ? '+' : ''}${val.toFixed(2)}%`;
};

// Related stocks in same sector
const relatedStocks = STOCK_SEED_DATA
  .filter(s => s.sector === stockSector && s.slug !== stockSlug)
  .slice(0, 6);

// Valuation & Insights
const valPe = stockData.fundamentals.pe || 25;
const valuationInsight = valPe < 20
  ? `${stockName} currently trades at an attractive P/E ratio of ${valPe}, reflecting a discounted valuation compared to broader sector averages.`
  : valPe < 35
  ? `${stockName} trades at a balanced P/E of ${valPe}, reflecting strong institutional market trust and consistent compound returns.`
  : `${stockName} commands a premium valuation with a P/E of ${valPe}, supported by high market dominance and profitability expectations.`;

const profitabilityInsight = `${stockName} maintains high capital efficiency with an ROE of ${stockData.fundamentals.roe}% and operating margins of ${stockData.fundamentals.operatingMargin}%, demonstrating robust cash generation capabilities.`;

const dividendInsight = stockData.dividend.yield
  ? `${stockName} offers a competitive dividend yield of ${stockData.dividend.yield}% with an annual dividend rate of ₹${stockData.dividend.rate}, making it attractive for passive income investors.`
  : `${stockName} prioritizes capital reinvestment into business expansion over aggressive dividend payouts.`;

// Dynamic H1 Title, Meta Tags & Canonical per Tab
let pageH1 = `${stockName} (${shortSymbol.toUpperCase()}) Share Price & Analysis`;
let metaTitle = `${stockName} (${shortSymbol.toUpperCase()}) Share Price Today | Fundamentals & PE Ratio | Arthavi`;
let metaDescription = `Track ${stockName} (${shortSymbol.toUpperCase()}) share price, valuation metrics, P/E ratio, market cap, dividend yield, company profile, and financial performance on Arthavi.`;

if (activeTab === 'share-price') {
  pageH1 = `${stockName} Share Price Today, 52-Week Range & Price Target`;
  metaTitle = `${stockName} Share Price Today, 52 Week High Low & Target Price | Arthavi`;
  metaDescription = `Check live ${stockName} share price today, 52-week high/low range, price target, analyst recommendations, and technical performance indicators on Arthavi.`;
} else if (activeTab === 'financials') {
  pageH1 = `${stockName} Financial Statements, P/E Ratio & ROE Valuation`;
  metaTitle = `${stockName} Financials, P/E Ratio & Valuation Metrics | Arthavi`;
  metaDescription = `Comprehensive financial analysis for ${stockName} including P/E ratio, ROE, profit margins, balance sheet metrics, cash flows, and EV/EBITDA multiples.`;
} else if (activeTab === 'dividend') {
  pageH1 = `${stockName} Dividend History, Annual Yield & Ex-Date`;
  metaTitle = `${stockName} Dividend History, Yield & Ex-Date | Arthavi`;
  metaDescription = `Track ${stockName} dividend yield, payout rate, ex-dividend dates, split history, and income performance metrics on Arthavi.`;
} else if (activeTab === 'shareholding-pattern') {
  pageH1 = `${stockName} Shareholding Pattern: Promoter & FII Holding`;
  metaTitle = `${stockName} Shareholding Pattern, Promoter & FII Holding | Arthavi`;
  metaDescription = `Analyze ${stockName} ownership structure including promoter holdings, FII/DII institutional stake, cash reserves, and debt-to-equity metrics.`;
} else if (activeTab === 'peer-comparison') {
  pageH1 = `${stockName} Peer Comparison & Sector Competitors`;
  metaTitle = `${stockName} Peer Comparison & Sector Competitors | Arthavi`;
  metaDescription = `Compare ${stockName} against top ${stockSector} competitors on P/E ratio, ROE, market capitalization, margins, and dividend yields.`;
}

// Canonical URL (Self-referencing for indexability)
const canonicalUrl = `https://arthavi.com/stocks/${stockSlug}/${activeTab !== 'overview' ? activeTab + '/' : ''}`;

// Dynamic FAQ list per tab for Unique HTML Content & Schema
let tabFaqs = [];

if (activeTab === 'overview') {
  tabFaqs = [
    {
      q: `What is ${stockName} share price today?`,
      a: `${stockName} (${shortSymbol.toUpperCase()}) is currently trading at ₹${stockData.price.toLocaleString('en-IN')}, with a day change of ${formatPercent(stockData.changePercent)}.`
    },
    {
      q: `Is ${stockName} a large cap company?`,
      a: `With a market capitalization of ${formatCurrency(stockData.fundamentals.marketCap)}, ${stockName} is categorized as a leading company in the ${stockSector} sector in India.`
    },
    {
      q: `What is ${stockName} P/E ratio?`,
      a: `${stockName} trades at a P/E ratio of ${stockData.fundamentals.pe || 'N/A'} and a Forward P/E of ${stockData.fundamentals.forwardPE || 'N/A'}.`
    },
    {
      q: `What sector does ${stockName} belong to?`,
      a: `${stockName} belongs to the ${stockSector} sector in India.`
    },
    {
      q: `What is ${stockName} dividend yield?`,
      a: stockData.dividend.yield
        ? `${stockName} offers a dividend yield of ${stockData.dividend.yield}% with an annual dividend rate of ₹${stockData.dividend.rate}.`
        : `${stockName} currently does not pay a regular dividend or dividend data is not available.`
    },
    {
      q: `What is ${stockName} 52-week high and low?`,
      a: stockData.performance.high52 && stockData.performance.low52
        ? `${stockName} has traded between ₹${stockData.performance.low52} (52-week low) and ₹${stockData.performance.high52} (52-week high).`
        : `52-week price range data for ${stockName} is currently being updated.`
    },
    {
      q: `What is ${stockName} return on equity (ROE)?`,
      a: stockData.fundamentals.roe
        ? `${stockName} has an ROE of ${stockData.fundamentals.roe}%, showing how efficiently the company generates profit from shareholder equity.`
        : `ROE data for ${stockName} is currently being updated.`
    },
    {
      q: `Is ${stockName} good for long-term investment?`,
      a: `${stockName} is a leading ${stockSector} company in India with a market cap of ${formatCurrency(stockData.fundamentals.marketCap)} and a P/E ratio of ${stockData.fundamentals.pe || 'N/A'}. Always consult a SEBI-registered financial advisor before investing.`
    }
  ];
} else if (activeTab === 'share-price') {
  tabFaqs = [
    {
      q: `What is ${stockName} 52-week high and 52-week low?`,
      a: `${stockName} has recorded a 52-week high of ₹${stockData.performance.high52 || 'N/A'} and a 52-week low of ₹${stockData.performance.low52 || 'N/A'}.`
    },
    {
      q: `What is analyst target price for ${stockName}?`,
      a: `Consensus analyst target price for ${stockName} is ₹${stockData.performance.targetPrice || 'N/A'}, based on overall Wall Street and Indian broker research updates.`
    },
    {
      q: `What was ${stockName} previous close and opening price?`,
      a: `${stockName} opened trading today at ₹${stockData.performance.open || 'N/A'} after closing at ₹${stockData.performance.previousClose || 'N/A'} in the previous session.`
    },
    {
      q: `How volatile is ${stockName} share price?`,
      a: `${stockName} operates in the ${stockSector} sector. Investors should monitor intraday day high (₹${stockData.performance.dayHigh || 'N/A'}) and day low (₹${stockData.performance.dayLow || 'N/A'}) levels alongside broader sector movements.`
    }
  ];
} else if (activeTab === 'financials') {
  tabFaqs = [
    {
      q: `What is ${stockName} P/E ratio and Price-to-Book (P/B) ratio?`,
      a: `${stockName} trades at a trailing P/E of ${stockData.fundamentals.pe || 'N/A'}, a Forward P/E of ${stockData.fundamentals.forwardPE || 'N/A'}, and a P/B ratio of ${stockData.fundamentals.pb || 'N/A'}.`
    },
    {
      q: `What is ${stockName} Return on Equity (ROE)?`,
      a: `${stockName} reports a Return on Equity (ROE) of ${stockData.fundamentals.roe ? stockData.fundamentals.roe + '%' : 'N/A'}, reflecting shareholder capital efficiency.`
    },
    {
      q: `What are ${stockName} profit margin and operating margin?`,
      a: `${stockName} maintains a net profit margin of ${stockData.fundamentals.profitMargin ? stockData.fundamentals.profitMargin + '%' : 'N/A'} and an operating margin of ${stockData.fundamentals.operatingMargin ? stockData.fundamentals.operatingMargin + '%' : 'N/A'}.`
    },
    {
      q: `What is ${stockName} Enterprise Value and EBITDA multiplier?`,
      a: `${stockName} has an Enterprise Value of ${formatCurrency(stockData.fundamentals.enterpriseValue)} and reported earnings per share (TTM EPS) of ₹${stockData.fundamentals.eps || 'N/A'}.`
    }
  ];
} else if (activeTab === 'dividend') {
  tabFaqs = [
    {
      q: `What is ${stockName} dividend yield?`,
      a: stockData.dividend.yield 
        ? `${stockName} offers a dividend yield of ${stockData.dividend.yield}%.`
        : `${stockName} currently does not pay a regular dividend yield or data is pending update.`
    },
    {
      q: `What is ${stockName} annual dividend rate per share?`,
      a: `${stockName} pays an annual dividend rate of ₹${stockData.dividend.rate || '0.00'} per share.`
    },
    {
      q: `When was ${stockName} last ex-dividend date?`,
      a: `${stockName}'s last recorded ex-dividend date was ${stockData.dividend.exDate || 'N/A'}.`
    },
    {
      q: `Has ${stockName} announced stock splits or bonus shares?`,
      a: `${stockName}'s last recorded stock split factor was ${stockData.dividend.lastSplit || 'N/A'}.`
    }
  ];
} else if (activeTab === 'shareholding-pattern') {
  tabFaqs = [
    {
      q: `What is promoter holding percentage in ${stockName}?`,
      a: `Promoters hold ${stockData.ownership.promoter ? stockData.ownership.promoter + '%' : 'N/A'} of total equity shares in ${stockName}.`
    },
    {
      q: `What is FII and institutional holding in ${stockName}?`,
      a: `Foreign Institutional Investors (FII) and domestic institutions hold ${stockData.ownership.fii ? stockData.ownership.fii + '%' : 'N/A'} of ${stockName}.`
    },
    {
      q: `What is ${stockName} Debt-to-Equity ratio?`,
      a: `${stockName} maintains a debt-to-equity ratio of ${stockData.ownership.debtToEquity !== null ? stockData.ownership.debtToEquity : 'N/A'}, reflecting balance sheet leverage.`
    },
    {
      q: `How much cash reserves does ${stockName} hold?`,
      a: `${stockName} holds total cash and equivalent liquid reserves of ${formatCurrency(stockData.ownership.cash)}.`
    }
  ];
} else if (activeTab === 'peer-comparison') {
  tabFaqs = [
    {
      q: `Who are ${stockName}'s main sector competitors in India?`,
      a: `${stockName} competes with leading ${stockSector} companies in India including ${relatedStocks.map(s => s.name).join(', ')}.`
    },
    {
      q: `How does ${stockName}'s valuation compare with sector peers?`,
      a: `${stockName} trades at a P/E of ${stockData.fundamentals.pe || 'N/A'}. Compare this against ${stockSector} industry averages to evaluate if the stock is trading at a premium or discount.`
    },
    {
      q: `Which company has the largest market cap among ${stockName}'s peers?`,
      a: `${stockName} has a market cap of ${formatCurrency(stockData.fundamentals.marketCap)}. Check our peer comparison table to review relative sizes across the ${stockSector} sector.`
    },
    {
      q: `Why compare ${stockName} with sector peers?`,
      a: `Comparing P/E ratio, ROE, margins, and market cap against ${stockSector} competitors helps investors identify value traps and quality industry leaders.`
    }
  ];
}

// Schema JSON-LD tailored per sub-page with GEO & FinancialProduct schema
const schemaGraph = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FinancialProduct",
      "@id": `https://arthavi.com/stocks/${stockSlug}/#financialproduct`,
      "name": stockName,
      "tickerSymbol": stockSymbol,
      "description": stockData.company.description || metaDescription,
      "category": stockSector,
      "offers": {
        "@type": "Offer",
        "price": stockData.price,
        "priceCurrency": stockData.currency || "INR"
      }
    },
    {
      "@type": "Corporation",
      "@id": `https://arthavi.com/stocks/${stockSlug}/#corporation`,
      "name": stockName,
      "tickerSymbol": stockSymbol,
      "description": stockData.company.description,
      "url": stockData.company.website,
      "numberOfEmployees": stockData.company.employees
    },
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      "url": canonicalUrl,
      "name": metaTitle,
      "description": metaDescription
    },
    {
      "@type": "FAQPage",
      "mainEntity": tabFaqs.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
});

// Breadcrumbs per tab
const breadcrumbItems = [
  { name: "Home", url: "https://arthavi.com/" },
  { name: "Stocks", url: "https://arthavi.com/stocks/" },
  { name: stockName, url: `https://arthavi.com/stocks/${stockSlug}/` }
];

if (activeTab !== 'overview') {
  const tabLabelMap: Record<string, string> = {
    'share-price': 'Share Price',
    'financials': 'Financials',
    'dividend': 'Dividends',
    'shareholding-pattern': 'Shareholding',
    'peer-comparison': 'Peer Comparison'
  };
  breadcrumbItems.push({
    name: tabLabelMap[activeTab] || activeTab,
    url: canonicalUrl
  });
}

const breadcrumb = { items: breadcrumbItems };
---

<Layout 
  title={metaTitle} 
  description={metaDescription} 
  canonical={canonicalUrl}
  schema={schemaGraph}
  breadcrumb={breadcrumb}
>
  <!-- Sticky Stock Header Bar on Scroll -->
  <div id="sticky-stock-bar" class="sticky-stock-bar hidden">
    <div class="container sticky-bar-inner">
      <div class="sticky-bar-info">
        <span class="sticky-bar-name">{stockName}</span>
        <span class="sticky-bar-symbol">{shortSymbol.toUpperCase()}</span>
      </div>
      <div class="sticky-bar-price">
        <span class="sticky-price-value">₹{stockData.price.toFixed(2)}</span>
        <span class={`sticky-price-change ${stockData.change >= 0 ? 'text-green' : 'text-red'}`}>
          {formatPercent(stockData.changePercent)}
        </span>
      </div>
      <a href="https://app.arthavi.com/register" class="btn btn-primary btn-sm">Track in Portfolio</a>
    </div>
  </div>

  <main class="stock-page-container">
    <!-- Breadcrumb Navigation -->
    <nav class="container breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/">Home</a></li>
        <li><span class="crumb-separator">/</span></li>
        <li><a href="/stocks/">Stocks</a></li>
        <li><span class="crumb-separator">/</span></li>
        {activeTab === 'overview' ? (
          <li class="crumb-active" aria-current="page">{stockName}</li>
        ) : (
          <>
            <li><a href={`/stocks/${stockSlug}/`}>{stockName}</a></li>
            <li><span class="crumb-separator">/</span></li>
            <li class="crumb-active" aria-current="page">
              {activeTab === 'share-price' && 'Share Price'}
              {activeTab === 'financials' && 'Financials'}
              {activeTab === 'dividend' && 'Dividends'}
              {activeTab === 'shareholding-pattern' && 'Shareholding'}
              {activeTab === 'peer-comparison' && 'Peer Comparison'}
            </li>
          </>
        )}
      </ol>
      <div class="meta-timestamps">
        <span>⏱ 4 min read</span>
        <span class="meta-dot">·</span>
        <span>Updated Today</span>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="container stock-hero">
      <div class="hero-main-card glass-panel">
        <div class="hero-top-row">
          <div>
            <div class="badge-row">
              <span class="sector-badge">{stockSector}</span>
              <span class="ticker-badge">NSE: {shortSymbol.toUpperCase()}</span>
            </div>
            <h1 class="stock-title">{pageH1}</h1>
            <p class="stock-subtitle">{stockName} ({shortSymbol.toUpperCase()}) — {stockData.company.industry}</p>
          </div>

          <div class="price-box text-right">
            <div class="main-price">
              ₹{stockData.price.toLocaleString('en-IN', { minimumFractionDigits: 2 })}
              <span class="price-currency">{stockData.currency}</span>
            </div>
            <div class={`price-change-pill ${stockData.change >= 0 ? 'bg-green-soft text-green' : 'bg-red-soft text-red'}`}>
              {stockData.change >= 0 ? '▲' : '▼'} ₹{Math.abs(stockData.change).toFixed(2)} ({formatPercent(stockData.changePercent)})
            </div>
          </div>
        </div>

        <!-- Action Bar -->
        <div class="hero-actions-row">
          <div class="action-buttons">
            <a href="https://app.arthavi.com/register" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              Track in Portfolio
            </a>
          </div>

          <div class="utility-buttons">
            <button type="button" id="copy-symbol-btn" class="icon-btn" title="Copy Stock Symbol" data-symbol={shortSymbol.toUpperCase()}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <span id="copy-toast" class="btn-tooltip">Copied!</span>
            </button>
            <button type="button" id="share-page-btn" class="icon-btn" title="Share Page">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Subpage Navigation Tabs (Direct Hyperlinks for Clean Crawling) -->
    <section class="container tab-nav-section">
      <div class="tab-scroll-container">
        <a href={`/stocks/${stockSlug}/`} class={`tab-link ${activeTab === 'overview' ? 'is-active' : ''}`}>Overview</a>
        <a href={`/stocks/${stockSlug}/share-price/`} class={`tab-link ${activeTab === 'share-price' ? 'is-active' : ''}`}>Share Price</a>
        <a href={`/stocks/${stockSlug}/financials/`} class={`tab-link ${activeTab === 'financials' ? 'is-active' : ''}`}>Financials & P/E</a>
        <a href={`/stocks/${stockSlug}/dividend/`} class={`tab-link ${activeTab === 'dividend' ? 'is-active' : ''}`}>Dividends</a>
        <a href={`/stocks/${stockSlug}/shareholding-pattern/`} class={`tab-link ${activeTab === 'shareholding-pattern' ? 'is-active' : ''}`}>Shareholding</a>
        <a href={`/stocks/${stockSlug}/peer-comparison/`} class={`tab-link ${activeTab === 'peer-comparison' ? 'is-active' : ''}`}>Peer Comparison</a>
      </div>
    </section>

    <!-- ==================== TAB 1: OVERVIEW ==================== -->
    {activeTab === 'overview' && (
      <>
        <!-- GEO / AEO Direct Answer Executive Summary Box -->
        <section class="container section-space" style="margin-bottom: 1rem;">
          <div class="glass-panel content-box" style="padding: 1.5rem 1.8rem; background: rgba(56, 189, 248, 0.04); border: 1px solid rgba(56, 189, 248, 0.2);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 0.5rem;">
              <span style="color: #38BDF8; font-weight: 700; font-size: 0.95rem;">✨ Executive Direct Answer Summary — {stockName}</span>
