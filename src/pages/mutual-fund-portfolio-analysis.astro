---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Mutual Fund Portfolio Analysis India — Free Overlap & XIRR Review | Arthavi",
  description: "Get a deep diagnostic of your mutual fund portfolio: AMC concentration, sector risks, underlying stock overlap, and true cash-flow XIRR with Arthavi AI.",
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Arthavi Mutual Fund Portfolio Analysis",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
      "description": "Comprehensive portfolio analysis across mutual funds, asset allocation, AMC concentration, and sector risks."
    }
  ]
});
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords="mutual fund portfolio analysis india, mutual fund portfolio review, portfolio overlap checker, amc concentration risk"
  schema={schema}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "Portfolio Analysis", url: "https://arthavi.com/mutual-fund-portfolio-analysis/" }
    ]
  }}
>

<main style="padding-top: 7rem; padding-bottom: 5rem;">
  <section style="padding-top: 1rem; position: relative; z-index: 2;">
    <div class="container">

      <div class="section-header text-center fade-in" style="margin-bottom: 3.5rem;">
        <span style="display:inline-block; background: rgba(168,85,247,0.12); border: 1px solid rgba(168,85,247,0.3); color: #c084fc; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 100px; margin-bottom: 1rem;">Portfolio Diagnostics · AI Wealth Coach</span>
        <h1 class="heading-xl" style="margin-bottom: 1rem;">Mutual Fund Portfolio Analysis</h1>
        <p style="max-width: 720px; margin: 0 auto; color: var(--text-muted); font-size: 1.15rem; line-height: 1.6;">
          Are you truly diversified or just collecting schemes? Uncover hidden stock overlap, AMC concentration risk, and evaluate true cash-flow performance.
        </p>
        <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 0.9rem 2rem;">Analyze My Portfolio</a>
          <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 0.9rem 2rem;">View Demo</a>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.8rem; margin-bottom: 4rem;">
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">🎯</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">Portfolio Health Score (0–100)</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">An objective algorithmic rating measuring your equity/debt balance, fund house concentration, and expense ratio efficiency.</p>
        </div>
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">🏢</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">AMC Concentration Alert</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">Detect if more than 35% of your mutual fund corpus is concentrated within a single Asset Management Company.</p>
        </div>
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">🤖</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">Ask AI Wealth Coach</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">Query your portfolio in plain English: "Am I too exposed to IT sector?", "Which fund dragged down my 1-year returns?", or "Where should my next SIP go?".</p>
        </div>
      </div>

      <div style="text-align: center; padding: 2rem 0 3rem;">
        <h2 style="margin-bottom: 1rem;">Get an objective audit of your mutual funds</h2>
        <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem; margin-right: 1rem;">Upload CAS Free</a>
        <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Try Demo</a>
      </div>

    </div>
  </section>
</main>

</Layout>
