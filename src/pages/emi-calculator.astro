---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "EMI Calculator 2025 — Home Loan, Car, Personal Loan | Arthavi",
  description: "Free EMI calculator for any loan — home loan, car loan, personal loan, education loan. Uses standard RBI formula. View full amortization schedule. No sign-up needed.",
};
---

<Layout
  title={seo.title}
  description={seo.description}
  keywords="EMI calculator, loan EMI calculator, home loan EMI calculator, car loan EMI calculator, personal loan EMI calculator, EMI formula, monthly EMI, amortization schedule India"
  breadcrumb={{ items: [{ name: "Home", url: "https://arthavi.com/" }, { name: "Calculators", url: "https://arthavi.com/calculators" }, { name: "EMI Calculator", url: "https://arthavi.com/emi-calculator" }] }}
  schema={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebPage",
        "@id": "https://arthavi.com/emi-calculator",
        "url": "https://arthavi.com/emi-calculator",
        "name": "EMI Calculator 2025 — Home Loan, Car, Personal Loan | Arthavi",
        "description": "Free EMI calculator for any loan. Calculate monthly EMI, total interest, and view full amortization schedule.",
        "inLanguage": "en-IN",
        "dateModified": "2025-07-24"
      },
      {
        "@type": "WebApplication",
        "name": "EMI Calculator",
        "url": "https://arthavi.com/emi-calculator",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "Any",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" }
      },
      {
        "@type": "HowTo",
        "name": "How to calculate EMI for a loan",
        "description": "Calculate your monthly EMI using the standard RBI formula in 3 steps.",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Enter loan amount", "text": "Input the total loan amount you wish to borrow (principal)." },
          { "@type": "HowToStep", "position": 2, "name": "Enter annual interest rate", "text": "Enter the annual interest rate offered by your bank (e.g., 8.5% for SBI home loan)." },
          { "@type": "HowToStep", "position": 3, "name": "Enter loan tenure", "text": "Select loan tenure in months or years. Home loans can be up to 30 years." },
          { "@type": "HowToStep", "position": 4, "name": "Get your EMI", "text": "The calculator shows monthly EMI, total interest payable, and total repayment amount using the formula: EMI = [P × R × (1+R)^N] / [(1+R)^N – 1]." }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "What is the EMI formula?", "acceptedAnswer": { "@type": "Answer", "text": "EMI = [P × R × (1+R)^N] / [(1+R)^N – 1], where P = Principal loan amount, R = Monthly interest rate (Annual rate ÷ 12 ÷ 100), N = Loan tenure in months. For example, ₹20 lakh loan at 8.5% for 20 years: EMI ≈ ₹17,356/month." } },
          { "@type": "Question", "name": "What is the EMI for ₹10 lakh personal loan?", "acceptedAnswer": { "@type": "Answer", "text": "At 12% annual interest for 5 years (60 months), the EMI for ₹10 lakh personal loan is approximately ₹22,244/month. Total interest paid = ₹3.35 lakh. Total repayment = ₹13.35 lakh." } },
          { "@type": "Question", "name": "Which bank offers the lowest home loan EMI?", "acceptedAnswer": { "@type": "Answer", "text": "As of July 2025, SBI offers home loans starting at 8.50% p.a., HDFC Bank at 8.75% p.a., and LIC HFL at 8.65% p.a. Lower interest rates significantly reduce your EMI and total interest burden." } },
          { "@type": "Question", "name": "Does prepayment reduce EMI or tenure?", "acceptedAnswer": { "@type": "Answer", "text": "Most banks offer two options on prepayment: (1) Reduce EMI keeping tenure constant, or (2) Reduce tenure keeping EMI constant. Reducing tenure saves more interest in the long run. RBI mandates no prepayment penalty for floating rate home loans." } },
          { "@type": "Question", "name": "What is an amortization schedule?", "acceptedAnswer": { "@type": "Answer", "text": "An amortization schedule shows the monthly breakup of each EMI into principal and interest components. In the early months, interest forms the majority of EMI. Over time, principal repayment increases. This schedule helps plan prepayments effectively." } }
        ]
      }
    ]
  })}
>
  <main style="padding-top: 5.5rem;">
    <section class="calc-page-hero">
      <div class="container">
        <div class="calc-breadcrumb">
          <a href="/calculators/">Calculators</a>
          <span>→</span>
          <span>EMI Calculator</span>
        </div>
        <div class="calc-hero-content">
          <div class="calc-hero-left">
            <span class="calc-badge">💳 Loan Calculator</span>
            <h1>EMI Calculator</h1>
            <p class="calc-hero-desc">
              An <strong>EMI (Equated Monthly Instalment) calculator</strong> computes your fixed monthly repayment for any loan using the formula:
              <code>EMI = [P × R × (1+R)^N] / [(1+R)^N – 1]</code>.
              Works for home loans, car loans, personal loans, and education loans.
            </p>
            <div class="calc-quick-facts">
              <div class="quick-fact"><span class="qf-label">SBI Home Loan</span><span class="qf-val">8.50% p.a.</span></div>
              <div class="quick-fact"><span class="qf-label">SBI Car Loan</span><span class="qf-val">9.15% p.a.</span></div>
              <div class="quick-fact"><span class="qf-label">Personal Loan</span><span class="qf-val">10.5–24% p.a.</span></div>
            </div>
          </div>
          <div class="calc-hero-right">
            <div class="calc-panel glass-panel">
              <h2 class="calc-panel-title">EMI Calculator</h2>

              <!-- Loan Type Tabs -->
              <div class="loan-type-tabs">
                <button class="loan-tab active" data-rate="8.5" onclick="setLoanType(this, 8.5)">🏡 Home Loan</button>
                <button class="loan-tab" data-rate="9.15" onclick="setLoanType(this, 9.15)">🚗 Car Loan</button>
                <button class="loan-tab" data-rate="12" onclick="setLoanType(this, 12)">💳 Personal</button>
              </div>

              <div class="calc-inputs">
                <div class="calc-input-group">
                  <label for="emi-principal">Loan Amount</label>
                  <div class="input-row">
                    <span class="input-prefix">₹</span>
                    <input type="number" id="emi-principal" value="2000000" min="10000" max="100000000" step="10000">
                  </div>
                  <input type="range" id="emi-principal-slider" min="10000" max="10000000" step="10000" value="2000000" class="calc-slider">
                  <div class="slider-labels"><span>₹10K</span><span>₹1 Cr</span></div>
                </div>

                <div class="calc-input-group">
                  <label for="emi-rate">Annual Interest Rate</label>
                  <div class="input-row">
                    <input type="number" id="emi-rate" value="8.5" min="1" max="36" step="0.05">
                    <span class="input-suffix">%</span>
                  </div>
                  <input type="range" id="emi-rate-slider" min="1" max="24" step="0.25" value="8.5" class="calc-slider">
                  <div class="slider-labels"><span>1%</span><span>24%</span></div>
                </div>

                <div class="calc-input-group">
                  <label for="emi-tenure">Loan Tenure</label>
                  <div class="input-row">
                    <input type="number" id="emi-tenure" value="20" min="1" max="30">
                    <span class="input-suffix">Years</span>
                  </div>
                  <input type="range" id="emi-tenure-slider" min="1" max="30" step="1" value="20" class="calc-slider">
                  <div class="slider-labels"><span>1 yr</span><span>30 yrs</span></div>
                </div>
              </div>

              <div class="calc-results">
                <div class="result-main">
                  <span class="result-label">Monthly EMI</span>
                  <span class="result-value" id="emi-result">₹17,356</span>
                </div>
                <div class="result-breakdown">
                  <div class="result-item">
                    <span>Total Principal</span>
                    <span id="emi-principal-total">₹20,00,000</span>
                  </div>
                  <div class="result-item">
                    <span>Total Interest</span>
                    <span id="emi-interest-total" style="color:#f59e0b">₹21,65,421</span>
                  </div>
                  <div class="result-item result-item-bold">
                    <span>Total Repayment</span>
                    <span id="emi-total" style="color:#34d399">₹41,65,421</span>
                  </div>
                </div>
                <!-- Pie Donut -->
                <div class="result-donut-wrap">
                  <svg viewBox="0 0 100 100" class="donut-svg" id="emi-donut">
                    <circle cx="50" cy="50" r="38" fill="none" stroke="rgba(99,102,241,0.3)" stroke-width="12"/>
                    <circle cx="50" cy="50" r="38" fill="none" stroke="#6366f1" stroke-width="12"
                      stroke-dasharray="239" stroke-dashoffset="120" stroke-linecap="round"
                      transform="rotate(-90 50 50)" id="emi-donut-principal"/>
                    <circle cx="50" cy="50" r="38" fill="none" stroke="#f59e0b" stroke-width="12"
                      stroke-dasharray="239" stroke-dashoffset="0" stroke-linecap="round"
                      transform="rotate(-90 50 50)" id="emi-donut-interest"/>
                  </svg>
                  <div class="donut-legend">
                    <div class="donut-leg-item"><span class="dot" style="background:#6366f1"></span>Principal</div>
                    <div class="donut-leg-item"><span class="dot" style="background:#f59e0b"></span>Interest</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Amortization Table -->
    <section class="amort-section">
      <div class="container">
        <h2 class="section-title-sm">Amortization Schedule</h2>
        <p class="section-sub-sm">Yearly breakup of principal vs interest repayment</p>
        <div class="amort-table-wrap">
          <table class="amort-table" id="amort-table">
            <thead>
              <tr>
                <th>Year</th>
                <th>Opening Balance</th>
                <th>Principal Paid</th>
                <th>Interest Paid</th>
                <th>Closing Balance</th>
              </tr>
            </thead>
            <tbody id="amort-body"></tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- How It Works -->
    <section class="info-section">
      <div class="container">
        <div class="info-grid">
          <div class="info-content">
            <h2>How is EMI calculated?</h2>
            <p>EMI is calculated using the <strong>Reducing Balance Method</strong>, which is the RBI-mandated standard for all bank loans in India.</p>
            <div class="formula-box">
              <p class="formula-title">EMI Formula:</p>
              <p class="formula">EMI = [P × R × (1+R)^N] / [(1+R)^N – 1]</p>
              <p class="formula-legend">P = Principal | R = Monthly Rate (Annual ÷ 12 ÷ 100) | N = Tenure (months)</p>
            </div>
            <div class="example-box">
              <p class="example-title">Example:</p>
              <ul>
                <li>Loan: ₹20,00,000</li>
                <li>Rate: 8.5% p.a. → Monthly rate = 0.7083%</li>
                <li>Tenure: 20 years = 240 months</li>
                <li><strong>EMI = ₹17,356/month</strong></li>
              </ul>
            </div>
          </div>
          <div class="bank-rates-box">
            <h3>Current Bank Loan Rates (July 2025)</h3>
            <table class="rates-table">
              <thead><tr><th>Bank</th><th>Home Loan</th><th>Car Loan</th><th>Personal</th></tr></thead>
              <tbody>
                <tr><td>SBI</td><td>8.50%</td><td>9.15%</td><td>12.05%</td></tr>
                <tr><td>HDFC Bank</td><td>8.75%</td><td>9.25%</td><td>10.75%</td></tr>
                <tr><td>ICICI Bank</td><td>8.75%</td><td>9.30%</td><td>10.80%</td></tr>
                <tr><td>Axis Bank</td><td>8.75%</td><td>9.20%</td><td>10.80%</td></tr>
                <tr><td>Kotak Bank</td><td>8.70%</td><td>9.25%</td><td>10.99%</td></tr>
              </tbody>
            </table>
            <p class="rates-note">* Rates indicative as of July 2025. Subject to change based on RBI repo rate.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq-section">
      <div class="container">
        <h2 class="faq-heading">Frequently Asked Questions</h2>
        <div class="faq-list">
          <div class="faq-item" onclick="this.classList.toggle('open')">
            <div class="faq-q">What is the EMI formula? <span class="faq-icon">+</span></div>
            <div class="faq-a">EMI = [P × R × (1+R)^N] / [(1+R)^N – 1], where P = Principal, R = Monthly interest rate (Annual ÷ 12 ÷ 100), N = Loan tenure in months. For a ₹20 lakh loan at 8.5% for 20 years: EMI ≈ ₹17,356/month.</div>
          </div>
          <div class="faq-item" onclick="this.classList.toggle('open')">
            <div class="faq-q">What is the EMI for ₹10 lakh personal loan for 5 years? <span class="faq-icon">+</span></div>
            <div class="faq-a">At 12% annual interest for 5 years (60 months), the EMI is approximately ₹22,244/month. Total interest paid = ₹3.35 lakh. Total repayment = ₹13.35 lakh.</div>
          </div>
          <div class="faq-item" onclick="this.classList.toggle('open')">
            <div class="faq-q">Does prepayment reduce EMI or tenure? <span class="faq-icon">+</span></div>
            <div class="faq-a">Most banks offer two options: (1) Reduce EMI keeping tenure same, or (2) Reduce tenure keeping EMI same. Reducing tenure saves more interest. RBI mandates zero prepayment penalty on floating rate home loans.</div>
          </div>
          <div class="faq-item" onclick="this.classList.toggle('open')">
            <div class="faq-q">What is the difference between flat rate and reducing balance EMI? <span class="faq-icon">+</span></div>
            <div class="faq-a">Flat rate calculates interest on the full principal throughout tenure. Reducing balance (used by all RBI-regulated banks) calculates interest on outstanding principal, which decreases with each EMI. A flat rate of 8% = approximately 14-15% in reducing balance terms.</div>
          </div>
          <div class="faq-item" onclick="this.classList.toggle('open')">
            <div class="faq-q">How can I reduce my loan EMI? <span class="faq-icon">+</span></div>
            <div class="faq-a">Three ways: (1) Increase down payment to lower principal, (2) Negotiate lower interest rate — even 0.25% reduction on ₹50 lakh saves ₹8+ lakh over 20 years, (3) Extend tenure — but this increases total interest. Refinancing/balance transfer is also a good option when rates fall.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Calculators -->
    <section class="related-section">
      <div class="container">
        <h2 class="related-heading">Related Calculators</h2>
        <div class="related-grid">
          <a href="/home-loan-emi-calculator/" class="related-card">
            <span class="related-icon">🏡</span>
            <div><strong>Home Loan EMI</strong><p>Bank rates & tax benefits</p></div>
          </a>
          <a href="/car-loan-emi-calculator/" class="related-card">
            <span class="related-icon">🚗</span>
            <div><strong>Car Loan EMI</strong><p>SBI, HDFC auto loan rates</p></div>
          </a>
          <a href="/fd-calculator/" class="related-card">
            <span class="related-icon">🏦</span>
            <div><strong>FD Calculator</strong><p>Maturity & interest earned</p></div>
          </a>
          <a href="/compound-interest-calculator/" class="related-card">
            <span class="related-icon">📊</span>
            <div><strong>Compound Interest</strong><p>Simple vs compound growth</p></div>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
function fmt(n) { return '₹' + Math.round(n).toLocaleString('en-IN'); }

function calcEMI() {
  const P = parseFloat(document.getElementById('emi-principal').value) || 0;
  const annualRate = parseFloat(document.getElementById('emi-rate').value) || 0;
  const years = parseFloat(document.getElementById('emi-tenure').value) || 0;
  const R = annualRate / 12 / 100;
  const N = years * 12;
  if (!P || !R || !N) return;

  const emi = P * R * Math.pow(1 + R, N) / (Math.pow(1 + R, N) - 1);
  const totalPayment = emi * N;
  const totalInterest = totalPayment - P;

  document.getElementById('emi-result').textContent = fmt(emi);
  document.getElementById('emi-principal-total').textContent = fmt(P);
  document.getElementById('emi-interest-total').textContent = fmt(totalInterest);
  document.getElementById('emi-total').textContent = fmt(totalPayment);

  // Donut
  const circumference = 239;
  const principalPct = P / totalPayment;
  const principalOffset = circumference * (1 - principalPct);
  const interestOffset = circumference * principalPct;
  const dp = document.getElementById('emi-donut-principal');
  const di = document.getElementById('emi-donut-interest');
  if (dp) {
    dp.setAttribute('stroke-dashoffset', principalOffset);
    di.setAttribute('stroke-dashoffset', interestOffset);
  }

  // Amortization
  buildAmortization(P, R, emi, N, years);
}

function buildAmortization(P, R, emi, N, years) {
  const body = document.getElementById('amort-body');
  if (!body) return;
  body.innerHTML = '';
  let balance = P;
  for (let y = 1; y <= years; y++) {
    let yearPrincipal = 0, yearInterest = 0;
    const openBalance = balance;
    for (let m = 0; m < 12 && (y - 1) * 12 + m < N; m++) {
      const interest = balance * R;
      const principal = Math.min(emi - interest, balance);
      yearInterest += interest;
      yearPrincipal += principal;
      balance -= principal;
    }
    if (balance < 0) balance = 0;
    const tr = document.createElement('tr');
    tr.innerHTML = `<td>Year ${y}</td><td>${fmt(openBalance)}</td><td>${fmt(yearPrincipal)}</td><td>${fmt(yearInterest)}</td><td>${fmt(Math.max(0, balance))}</td>`;
    body.appendChild(tr);
  }
}

function syncSlider(inputId, sliderId) {
  const input = document.getElementById(inputId);
  const slider = document.getElementById(sliderId);
  if (!input || !slider) return;
  input.addEventListener('input', () => { slider.value = input.value; calcEMI(); });
  slider.addEventListener('input', () => { input.value = slider.value; calcEMI(); });
}

function setLoanType(btn, rate) {
  document.querySelectorAll('.loan-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  const rateInput = document.getElementById('emi-rate');
  const rateSlider = document.getElementById('emi-rate-slider');
  if (rateInput) rateInput.value = rate;
  if (rateSlider) rateSlider.value = rate;
  // Set tenure
  const tenureInput = document.getElementById('emi-tenure');
  const tenureSlider = document.getElementById('emi-tenure-slider');
  const tenure = rate === 8.5 ? 20 : rate === 9.15 ? 7 : 5;
  if (tenureInput) tenureInput.value = tenure;
  if (tenureSlider) tenureSlider.value = tenure;
  calcEMI();
}
window.setLoanType = setLoanType;

document.addEventListener('DOMContentLoaded', () => {
  syncSlider('emi-principal', 'emi-principal-slider');
  syncSlider('emi-rate', 'emi-rate-slider');
  syncSlider('emi-tenure', 'emi-tenure-slider');
  calcEMI();
});
</script>

<style>
  /* Shared calculator page styles */
  .calc-page-hero { padding: 2rem 0 3rem; }
  .calc-breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; color: var(--text-muted); margin-bottom: 2rem; }
  .calc-breadcrumb a { color: var(--text-muted); text-decoration: none; } .calc-breadcrumb a:hover { color: #a5b4fc; }
  .calc-badge { display: inline-block; background: rgba(99,102,241,0.12); border: 1px solid rgba(99,102,241,0.25); color: #a5b4fc; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.25rem 0.8rem; border-radius: 100px; margin-bottom: 1rem; }
  .calc-hero-content { display: grid; grid-template-columns: 1fr 1.1fr; gap: 3rem; align-items: start; }
  .calc-hero-left h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; color: var(--text-head); margin-bottom: 1rem; line-height: 1.2; }
  .calc-hero-desc { color: var(--text-muted); line-height: 1.75; font-size: 0.95rem; margin-bottom: 1.5rem; }
  .calc-hero-desc strong { color: var(--text-head); }
  .calc-hero-desc code { background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.2); color: #a5b4fc; padding: 0.15rem 0.5rem; border-radius: 6px; font-size: 0.82rem; display: block; margin-top: 0.5rem; }
  .calc-quick-facts { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .quick-fact { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 0.65rem 1rem; }
  .qf-label { display: block; font-size: 0.72rem; color: var(--text-muted); margin-bottom: 0.2rem; }
  .qf-val { display: block; font-size: 1rem; font-weight: 700; color: #34d399; }

  /* Calculator Panel */
  .calc-panel { padding: 1.75rem; border-radius: 20px; }
  .calc-panel-title { font-size: 1.15rem; font-weight: 700; color: var(--text-head); margin-bottom: 1.25rem; }
  .loan-type-tabs { display: flex; gap: 0.4rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
  .loan-tab { flex: 1; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); color: var(--text-muted); border-radius: 8px; padding: 0.5rem 0.5rem; font-size: 0.8rem; font-weight: 500; cursor: pointer; transition: all 0.2s; font-family: inherit; text-align: center; }
  .loan-tab.active { background: rgba(99,102,241,0.15); border-color: rgba(99,102,241,0.4); color: #a5b4fc; font-weight: 600; }
  .calc-inputs { display: flex; flex-direction: column; gap: 1.1rem; margin-bottom: 1.25rem; }
  .calc-input-group label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.4rem; font-weight: 500; }
  .input-row { display: flex; align-items: center; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden; transition: border-color 0.2s; }
  .input-row:focus-within { border-color: rgba(99,102,241,0.4); }
  .input-prefix, .input-suffix { padding: 0.65rem 0.75rem; font-size: 0.9rem; color: var(--text-muted); background: rgba(255,255,255,0.02); border-right: 1px solid rgba(255,255,255,0.06); flex-shrink: 0; }
  .input-suffix { border-right: none; border-left: 1px solid rgba(255,255,255,0.06); }
  .input-row input { flex: 1; background: none; border: none; outline: none; padding: 0.65rem 0.75rem; color: var(--text-head); font-size: 0.95rem; font-family: inherit; width: 100%; }
  .calc-slider { width: 100%; margin-top: 0.5rem; accent-color: #6366f1; }
  .slider-labels { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-muted); margin-top: 0.15rem; }
  .calc-results { background: rgba(99,102,241,0.06); border: 1px solid rgba(99,102,241,0.15); border-radius: 14px; padding: 1.25rem; }
  .result-main { text-align: center; margin-bottom: 1rem; }
  .result-label { display: block; font-size: 0.78rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.25rem; }
  .result-value { font-size: 2rem; font-weight: 800; color: #a5b4fc; font-family: 'Outfit', sans-serif; }
  .result-breakdown { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1rem; }
