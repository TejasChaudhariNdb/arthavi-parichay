                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.15rem; color: var(--primary);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Market Prediction Card</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Daily market predictions</span></div>
                            </li>
