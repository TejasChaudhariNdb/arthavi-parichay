                            <div style="width: 46px; height: 46px; border-radius: 12px; background: linear-gradient(135deg, rgba(99,102,241,0.2) 0%, rgba(99,102,241,0.05) 100%); border: 1px solid rgba(99,102,241,0.2); display: flex; align-items: center; justify-content: center; color: var(--primary-glow); box-shadow: 0 4px 12px rgba(99,102,241,0.1);">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                            </div>
                            <h3 style="margin: 0; font-size: 1.35rem; color: var(--text-head); font-weight: 600;">Dashboard Features</h3>
                        </div>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.1rem; flex-grow: 1;">
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.15rem; color: var(--primary);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Net Worth Tracking</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Shows total portfolio value (MF + Stocks)</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.15rem; color: var(--primary);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
