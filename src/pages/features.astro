                    <!-- 5. CAMS & KFintech CAS Import Engine -->
                    <article class="feature-card glass-panel fade-in delay-200" style="display: flex; flex-direction: column; padding: 2.2rem;">
                        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 1.2rem;">
                            <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, rgba(16,185,129,0.25) 0%, rgba(16,185,129,0.05) 100%); border: 1px solid rgba(16,185,129,0.3); display: flex; align-items: center; justify-content: center; color: #34d399; box-shadow: 0 4px 12px rgba(16,185,129,0.15);">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                            </div>
                            <h2 style="margin: 0; font-size: 1.35rem; color: var(--text-head); font-weight: 600;">CAMS &amp; KFintech CAS Import</h2>
                        </div>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.1rem; flex-grow: 1;">
