---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Complete Feature List | Arthavi Portfolio Tracker",
  description: "Explore all 42+ powerful features of Arthavi. From Mutual Fund tracking and direct Stock insights, to AI chatbots, goal setting, and privacy modes.",
};
---

<Layout title={seo.title} description={seo.description} keywords="arthavi features, portfolio tracker features, mutual fund features, stock tracking features, ai investment tracker, complete feature list" schema={JSON.stringify({"@context":"https://schema.org","@graph":[{"@type":"SoftwareApplication","name":"Arthavi","applicationCategory":"FinanceApplication","operatingSystem":"Web, Android","offers":{"@type":"Offer","price":"0","priceCurrency":"INR"},"description":"Privacy-first portfolio tracker for Indian investors. Tracks mutual funds via CAS import and stocks with live NSE/BSE prices. No demat linking required."},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How many features does Arthavi have?","acceptedAnswer":{"@type":"Answer","text":"Arthavi currently has 42+ powerful features organized into 7 categories including Dashboard, Mutual Funds, Stocks, Transactions, Goals, AI Chat, and Settings."}},{"@type":"Question","name":"Does Arthavi track both Mutual Funds and Stocks?","acceptedAnswer":{"@type":"Answer","text":"Yes, Arthavi provides comprehensive tracking for both Mutual Funds and NSE/BSE stocks in a unified dashboard."}},{"@type":"Question","name":"How does the AI Investment Assistant work?","acceptedAnswer":{"@type":"Answer","text":"Arthavi's Ask AI feature analyzes your unique portfolio and answers your personal finance questions. It provides smart nudges and insights without needing any human advisor."}}]}]})} breadcrumb={{items:[{name:"Home",url:"https://arthavi.com/"},{name:"Features",url:"https://arthavi.com/features"}]}}>>
    <main style="padding-top: 8rem; padding-bottom: 4rem;">
        <section id="complete-features" class="features" style="padding-top: 2rem; position: relative; z-index: 2;">
            <div class="container">
                <div class="section-header text-center fade-in">
                    <span style="display:inline-block; background: rgba(99,102,241,0.12); border: 1px solid rgba(99,102,241,0.3); color: #a78bfa; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.3rem 0.9rem; border-radius: 100px; margin-bottom: 1rem;">Everything Inside</span>
                    <h2>Complete Feature List</h2>
                    <p>Everything you need to track, manage, and grow your wealth in one powerful app.</p>
                </div>
                
                <div class="features-grid" style="grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); margin-top: 3.5rem; gap: 2rem;">
                    
                    <!-- Dashboard Features -->
                    <article class="feature-card glass-panel fade-in delay-100" style="display: flex; flex-direction: column; padding: 2.2rem;">
