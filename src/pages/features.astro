---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Complete Feature Catalog | Arthavi Portfolio Tracker India",
  description: "Explore all 50+ powerful features of Arthavi: Multi-profile family wealth tracking, Capital Gains (LTCG/STCG) tax reports, CAS parser, live NSE/BSE stocks, and Ask AI.",
};
---

<Layout title={seo.title} description={seo.description} keywords="arthavi features, portfolio tracker features, mutual fund features, stock tracking features, ai investment tracker, family portfolio tracker, capital gains report india, ltcg stcg calculator, complete feature list" schema={JSON.stringify({"@context":"https://schema.org","@graph":[{"@type":"SoftwareApplication","name":"Arthavi","applicationCategory":"FinanceApplication","operatingSystem":"Web, Android, iOS PWA","offers":{"@type":"Offer","price":"0","priceCurrency":"INR"},"description":"Privacy-first portfolio tracker for Indian investors. Tracks mutual funds via CAS import, live NSE/BSE stocks, family portfolios, capital gains tax reports, and AI portfolio analysis. Zero broker passwords required."},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does Arthavi support family portfolio tracking across multiple PANs?","acceptedAnswer":{"@type":"Answer","text":"Yes. Arthavi features multi-profile family tracking, allowing you to organize folios and Demat accounts for Self, Spouse, Parents, Children, and HUF under one login with one-click aggregated net worth."}},{"@type":"Question","name":"Can Arthavi generate Capital Gains Tax reports for ITR filing?","acceptedAnswer":{"@type":"Answer","text":"Yes. Arthavi generates comprehensive realized LTCG and STCG tax reports with Section 112A grandfathering (Jan 31, 2018 FMV) and updated Budget tax rates (12.5% LTCG, 20% STCG) with direct CSV/Excel export."}},{"@type":"Question","name":"How does Arthavi AI analyze my portfolio?","acceptedAnswer":{"@type":"Answer","text":"Arthavi's Ask AI assistant reviews your holdings to identify hidden fund overlap, sector concentration risk, and answers plain-English questions about your asset allocation without human advisors or data selling."}}]}]})} breadcrumb={{items:[{name:"Home",url:"https://arthavi.com/"},{name:"Features",url:"https://arthavi.com/features"}]}}>
    <main style="padding-top: 7rem; padding-bottom: 5rem;">
        <section id="complete-features" class="features" style="padding-top: 1rem; position: relative; z-index: 2;">
            <div class="container">
                <div class="section-header text-center fade-in">
                    <span style="display:inline-block; background: rgba(99,102,241,0.12); border: 1px solid rgba(99,102,241,0.3); color: #a78bfa; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 100px; margin-bottom: 1rem;">Everything Built For Indian Investors</span>
                    <h1 class="heading-xl" style="margin-bottom: 1rem;">Complete Feature Catalog</h1>
                    <p style="max-width: 680px; margin: 0 auto; color: var(--text-muted); font-size: 1.1rem; line-height: 1.6;">
                        Explore every tool, report, and intelligence module built into Arthavi. Designed from the ground up for privacy, family wealth, and true cash-flow accuracy.
                    </p>
                </div>
                
                <div class="features-grid" style="grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); margin-top: 3.5rem; gap: 2rem;">
                    
                    <!-- 1. Family Wealth & Multi-Profile Tracking -->
                    <article class="feature-card glass-panel fade-in delay-100" style="display: flex; flex-direction: column; padding: 2.2rem; border-color: rgba(99,102,241,0.3);">
                        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 1.2rem;">
                            <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, rgba(99,102,241,0.25) 0%, rgba(99,102,241,0.05) 100%); border: 1px solid rgba(99,102,241,0.3); display: flex; align-items: center; justify-content: center; color: #a78bfa; box-shadow: 0 4px 12px rgba(99,102,241,0.15);">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                            </div>
                            <div>
                                <h2 style="margin: 0; font-size: 1.35rem; color: var(--text-head); font-weight: 600;">Multi-Profile Family Wealth</h2>
                                <span style="font-size: 0.8rem; color: #a78bfa; font-weight: 600;">Unique to Arthavi</span>
                            </div>
                        </div>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.1rem; flex-grow: 1;">
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: var(--primary);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Multi-PAN Management</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Track separate portfolios for Self, Spouse, Parents, Children, and HUF under one master account.</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: var(--primary);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Instant Profile Switching</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Switch between family member dashboards in a single click without logging out or re-authenticating.</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: var(--primary);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Aggregated Household Net Worth</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">View combined family net worth, combined asset allocation, and overall household XIRR performance.</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: var(--primary);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Independent CAS Sync</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Import separate CAMS/KFintech CAS PDFs for each individual family member with isolated folios.</span></div>
                            </li>
                        </ul>
                    </article>

                    <!-- 2. Capital Gains & Tax Readiness (LTCG / STCG) -->
                    <article class="feature-card glass-panel fade-in delay-200" style="display: flex; flex-direction: column; padding: 2.2rem; border-color: rgba(245,158,11,0.3);">
                        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 1.2rem;">
                            <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, rgba(245,158,11,0.25) 0%, rgba(245,158,11,0.05) 100%); border: 1px solid rgba(245,158,11,0.3); display: flex; align-items: center; justify-content: center; color: #fbbf24; box-shadow: 0 4px 12px rgba(245,158,11,0.15);">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            </div>
                            <div>
                                <h2 style="margin: 0; font-size: 1.35rem; color: var(--text-head); font-weight: 600;">Capital Gains & Tax Reports</h2>
                                <span style="font-size: 0.8rem; color: #fbbf24; font-weight: 600;">FY 2025-26 &amp; FY 2024-25 Ready</span>
                            </div>
                        </div>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.1rem; flex-grow: 1;">
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: #fbbf24;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Realized LTCG &amp; STCG Breakdown</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Accurate computation of short-term and long-term capital gains matching Indian Income Tax Act requirements.</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: #fbbf24;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Section 112A Grandfathering</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Automatic application of Jan 31, 2018 Fair Market Value (FMV) grandfathering for equity holdings.</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: #fbbf24;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Post-Budget 2024 Revised Tax Rates</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Calculates tax liability using revised 12.5% LTCG (₹1.25L exemption) and 20% STCG rules.</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: #fbbf24;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">One-Click Excel / CSV Export</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Download pre-formatted capital gains schedules ready for your Chartered Accountant or ITR-2 / ITR-3 filing.</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: #fbbf24;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Trade Basis Reconciliation</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">In-line editing of historical purchase prices and dates to resolve missing cost basis in legacy trades.</span></div>
                            </li>
                        </ul>
                    </article>

                    <!-- 3. Ask AI Investment Assistant -->
                    <article class="feature-card glass-panel fade-in delay-300" style="display: flex; flex-direction: column; padding: 2.2rem; border-color: rgba(167,139,250,0.3);">
                        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 1.2rem;">
                            <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, rgba(167,139,250,0.25) 0%, rgba(167,139,250,0.05) 100%); border: 1px solid rgba(167,139,250,0.3); display: flex; align-items: center; justify-content: center; color: #c084fc; box-shadow: 0 4px 12px rgba(167,139,250,0.15);">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z"></path></svg>
                            </div>
                            <div>
                                <h2 style="margin: 0; font-size: 1.35rem; color: var(--text-head); font-weight: 600;">Ask AI Investment Assistant</h2>
                                <span style="font-size: 0.8rem; color: #c084fc; font-weight: 600;">Ranked #1 for 'arthavi ai'</span>
                            </div>
                        </div>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.1rem; flex-grow: 1;">
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: #c084fc;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Context-Aware Portfolio Q&amp;A</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Ask questions directly about your investments in plain English: "Am I too heavy on midcaps?", "What is my total tech exposure?".</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: #c084fc;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Mutual Fund Overlap Detection</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Identifies duplicated underlying stock holdings between your large-cap, flexi-cap, and index funds.</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: #c084fc;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Sector Concentration Warnings</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Alerts you when Banking, IT, or Energy exposure exceeds healthy risk thresholds.</span></div>
                            </li>
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: #c084fc;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <div><strong style="color: var(--text-head); display: block; font-size: 0.95rem; margin-bottom: 0.15rem;">Zero Human Advisors</strong><span style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; display: block;">Unbiased analysis with zero commissions, no product cross-selling, and no third-party data access.</span></div>
                            </li>
                        </ul>
                    </article>

                    <!-- 4. Unified Dashboard & Net Worth Analytics -->
                    <article class="feature-card glass-panel fade-in delay-100" style="display: flex; flex-direction: column; padding: 2.2rem;">
                        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 1.2rem;">
                            <div style="width: 48px; height: 48px; border-radius: 12px; background: linear-gradient(135deg, rgba(59,130,246,0.25) 0%, rgba(59,130,246,0.05) 100%); border: 1px solid rgba(59,130,246,0.3); display: flex; align-items: center; justify-content: center; color: #60a5fa; box-shadow: 0 4px 12px rgba(59,130,246,0.15);">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                            </div>
                            <h2 style="margin: 0; font-size: 1.35rem; color: var(--text-head); font-weight: 600;">Net Worth &amp; Portfolio Dashboard</h2>
                        </div>
                        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1.1rem; flex-grow: 1;">
                            <li style="display: flex; gap: 0.85rem; align-items: flex-start;">
                                <svg style="flex-shrink: 0; margin-top: 0.2rem; color: var(--primary);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
