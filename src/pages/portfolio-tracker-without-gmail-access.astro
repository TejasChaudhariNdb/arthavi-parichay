  schema={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Portfolio Tracker Without Gmail Access",
    "description": "Learn the risks of automated email reading trackers and explore the best portfolio tracker without Gmail access in India.",
    "publisher": {
      "@type": "Organization",
      "name": "Arthavi",
      "logo": "https://arthavi.com/images/logo.png"
