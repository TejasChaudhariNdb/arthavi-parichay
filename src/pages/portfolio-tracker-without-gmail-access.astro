                    <thead>
                        <tr style="background:rgba(99,102,241,0.15); text-align:left;">
                            <th style="padding:0.9rem 1rem; border-bottom:2px solid rgba(255,255,255,0.1); color:var(--text-head);">Privacy Aspect</th>
                            <th style="padding:0.9rem 1rem; border-bottom:2px solid rgba(99,102,241,0.4); color:#a78bfa;">No Gmail Access (Arthavi)</th>
