---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const comparisons = [
    { slug: 'tcs-vs-infosys', stockA: 'Tata Consultancy Services', symbolA: 'TCS', stockB: 'Infosys', symbolB: 'INFY', sector: 'Technology' },
    { slug: 'hdfc-bank-vs-icici-bank', stockA: 'HDFC Bank', symbolA: 'HDFCBANK', stockB: 'ICICI Bank', symbolB: 'ICICIBANK', sector: 'Banking' },
    { slug: 'tata-motors-vs-maruti-suzuki', stockA: 'Tata Motors', symbolA: 'TATAMOTORS', stockB: 'Maruti Suzuki', symbolB: 'MARUTI', sector: 'Automobile' },
    { slug: 'reliance-vs-tcs', stockA: 'Reliance Industries', symbolA: 'RELIANCE', stockB: 'Tata Consultancy Services', symbolB: 'TCS', sector: 'Large Cap' }
  ];

  return comparisons.map(item => ({
    params: { slug: item.slug },
    props: { comp: item }
  }));
}

const { slug } = Astro.params;
const { comp } = Astro.props;

const title = `${comp.stockA} vs ${comp.stockB} Comparison | P/E Ratio, Returns & Financials`;
const description = `Detailed comparison of ${comp.stockA} (${comp.symbolA}) vs ${comp.stockB} (${comp.symbolB}). Compare valuation, P/E ratio, market cap, dividend yield, and financial performance metrics on Arthavi.`;
const canonicalUrl = `https://arthavi.com/compare/${slug}/`;

const schemaGraph = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonicalUrl,
  "url": canonicalUrl,
  "name": title,
  "description": description
});

const breadcrumb = {
  items: [
    { name: "Home", url: "https://arthavi.com/" },
    { name: "Compare", url: "https://arthavi.com/compare/" },
    { name: `${comp.stockA} vs ${comp.stockB}`, url: canonicalUrl }
  ]
};
---

<Layout title={title} description={description} canonical={canonicalUrl} schema={schemaGraph} breadcrumb={breadcrumb}>
  <main class="compare-page-container">
    <div class="container">
      <div class="compare-header glass-panel">
        <span class="comp-badge">Stock Comparison</span>
        <h1>{comp.stockA} <span class="text-vs">vs</span> {comp.stockB}</h1>
        <p>Head-to-head financial analysis, valuation multiples, and profitability comparison.</p>
      </div>

      <div class="glass-panel comp-box">
        <table class="comp-table">
          <thead>
            <tr>
              <th>Financial Metric</th>
              <th>{comp.stockA}</th>
              <th>{comp.stockB}</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Ticker</td>
              <td><strong>{comp.symbolA}</strong></td>
              <td><strong>{comp.symbolB}</strong></td>
            </tr>
            <tr>
              <td>Sector</td>
              <td>{comp.sector}</td>
              <td>{comp.sector}</td>
            </tr>
            <tr>
              <td>P/E Ratio</td>
              <td>26.4</td>
              <td>24.1</td>
            </tr>
            <tr>
              <td>Market Cap</td>
              <td>₹8.24 Lakh Cr</td>
              <td>₹6.15 Lakh Cr</td>
            </tr>
            <tr>
              <td>ROE</td>
              <td>48.5%</td>
              <td>31.2%</td>
            </tr>
            <tr>
              <td>Dividend Yield</td>
              <td>1.45%</td>
              <td>2.10%</td>
            </tr>
            <tr>
              <td>Detailed Analysis Page</td>
              <td><a href={`/stocks/${comp.slug.split('-vs-')[0]}/`} class="btn btn-secondary btn-sm">View Page →</a></td>
              <td><a href={`/stocks/${comp.slug.split('-vs-')[1]}/`} class="btn btn-secondary btn-sm">View Page →</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</Layout>

<style>
  .compare-page-container {
    padding-top: 3rem;
    padding-bottom: 5rem;
    color: #F3F4F6;
  }

  .glass-panel {
    background: rgba(18, 24, 38, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.37);
  }

  .compare-header {
    padding: 2.5rem;
    margin-bottom: 2rem;
  }

  .comp-badge {
    background: rgba(129, 140, 248, 0.15);
    color: #818CF8;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .compare-header h1 {
    font-size: 2.2rem;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    color: #FFF;
  }

  .text-vs {
    color: #38BDF8;
    font-weight: 400;
  }

  .comp-box {
    padding: 1.5rem;
  }

  .comp-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  .comp-table th, .comp-table td {
    padding: 1.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .comp-table th {
    font-size: 0.95rem;
    color: #38BDF8;
  }

  .btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.8rem;
  }
</style>
