</main>

<!-- Live fetch + resilient render script -->
<script is:inline>
(function () {
  const FEED_URL = 'https://nsearchives.nseindia.com/content/RSS/Corporate_action.xml';
  const PROXIES = [
    url => 'https://api.allorigins.win/raw?url=' + encodeURIComponent(url),
    url => 'https://corsproxy.io/?' + encodeURIComponent(url)
  ];

  let allItems = [];
  let activeFilter = 'ALL';

  // Initialize from server-rendered rows immediately so filters work with zero latency
  const existingRows = Array.from(document.querySelectorAll('#feed-body tr[data-type]'));
  if (existingRows.length) {
    allItems = existingRows.map(row => ({
      company: row.children[0]?.textContent?.trim() || '',
      type: row.dataset.type || 'OTHER',
      purpose: row.children[2]?.textContent?.trim() || '',
      exDate: row.children[3]?.textContent?.trim() || '',
      pubDate: row.children[4]?.textContent?.trim() || ''
    }));
  }

  function classifyType(desc, title) {
    const t = (desc + ' ' + title).toUpperCase();
    if (t.includes('BUYBACK') || t.includes('BUY BACK')) return 'BUYBACK';
    if (t.includes('RIGHTS')) return 'RIGHTS';
    if (t.includes('SPLIT') || t.includes('SUB-DIVISION')) return 'SPLIT';
    if (t.includes('BONUS')) return 'BONUS';
    if (t.includes('DIVIDEND')) return 'DIVIDEND';
    return 'OTHER';
  }

  const iconSvg = {
    DIVIDEND: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M15 9.5a2.5 2.5 0 0 0-5 0c0 2.5 5 2.5 5 5a2.5 2.5 0 0 1-5 0"/></svg>',
    SPLIT: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>',
    BONUS: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>',
    BUYBACK: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>',
    RIGHTS: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg>',
    OTHER: '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
  };

  function typeBadge(type) {
    const map = {
      DIVIDEND: ['badge-dividend', 'Dividend'],
      SPLIT: ['badge-split', 'Split'],
      BONUS: ['badge-bonus', 'Bonus'],
      BUYBACK: ['badge-buyback', 'Buyback'],
      RIGHTS: ['badge-rights', 'Rights'],
      OTHER: ['badge-other', 'Notice'],
    };
    const [cls, label] = map[type] || map.OTHER;
    const icon = iconSvg[type] || iconSvg.OTHER;
    return `<span class="type-badge ${cls}">${icon} ${label}</span>`;
  }

  function extractField(desc, field) {
    const re = new RegExp(field + ':([^|\\n]+)', 'i');
    const m = desc.match(re);
    return m ? m[1].trim() : '—';
  }

  function formatDetails(desc, type) {
    const purpose = extractField(desc, 'PURPOSE');
    const fv = extractField(desc, 'FACE VALUE');
    let out = purpose !== '—' ? purpose : desc.substring(0, 80);
    if (fv !== '—') out += ` (FV ₹${fv})`;
    return out;
  }

  function renderRows(items) {
    const tbody = document.getElementById('feed-body');
    if (!items.length) {
      tbody.innerHTML = `<tr><td colspan="5"><div class="empty-state"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#6b7a99" stroke-width="1.8" style="margin:0 auto 0.5rem;display:block;"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg><p>No corporate actions found for this filter. Select "All Actions".</p></div></td></tr>`;
      return;
    }
    tbody.innerHTML = items.map(item => {
      const exDate = item.exDate || extractField(item.desc || '', 'EX-DATE');
      const pub = item.pubDate || '—';
      const details = item.purpose || formatDetails(item.desc || '', item.type);
      return `<tr data-type="${item.type}">
        <td class="company-name">${item.company}</td>
        <td>${typeBadge(item.type)}</td>
        <td style="max-width:340px;font-size:0.85rem;color:#9bacc8">${details}</td>
        <td class="ex-date-cell">${exDate}</td>
        <td class="date-cell">${pub}</td>
      </tr>`;
    }).join('');
  }

  function applyFilter() {
    const filtered = activeFilter === 'ALL' ? allItems : allItems.filter(i => i.type === activeFilter);
    renderRows(filtered);
  }

  async function fetchWithFallback() {
    for (const proxyFn of PROXIES) {
      try {
        const res = await fetch(proxyFn(FEED_URL), { signal: AbortSignal.timeout(7000) });
        if (res.ok) {
          const text = await res.text();
          if (text && text.includes('<rss')) return text;
        }
      } catch (e) {
        // try next proxy
      }
    }
    return null;
  }

  async function loadFeed() {
    try {
      const xmlText = await fetchWithFallback();
      if (!xmlText) throw new Error('All proxies failed');

      const parser = new DOMParser();
      const xml = parser.parseFromString(xmlText, 'application/xml');

      const lastBuild = xml.querySelector('lastBuildDate');
      if (lastBuild) {
        document.getElementById('last-updated').textContent = lastBuild.textContent.trim();
      }

      const items = Array.from(xml.querySelectorAll('item'));
      if (items.length) {
        allItems = items.map(item => {
          const titleRaw = item.querySelector('title')?.textContent?.trim() || '';
          const desc = item.querySelector('description')?.textContent?.trim() || '';
          const pubDate = item.querySelector('pubDate')?.textContent?.trim() || '—';
          const company = titleRaw.split(' - Ex-Date')[0].split('\n')[0].trim();
          const type = classifyType(desc, titleRaw);
          const purpose = formatDetails(desc, type);
          const ex = extractField(desc, 'EX-DATE');
          const rec = extractField(desc, 'RECORD DATE');
          const exDate = ex !== '—' ? ex : rec;
          return { company, desc, pubDate, type, purpose, exDate };
        });
        applyFilter();
      }
    } catch (err) {
      console.warn('NSE live feed update skipped:', err);
      const tbody = document.getElementById('feed-body');
      if (!allItems.length && (!tbody || tbody.querySelector('.skeleton-row'))) {
        tbody.innerHTML = `
          <tr><td colspan="5">
            <div class="empty-state">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#eab308" stroke-width="1.8" style="margin:0 auto 0.5rem;display:block;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <p>Live disclosures refreshing. <a href="https://www.nseindia.com/companies-listing/corporate-filings-actions" target="_blank" rel="noopener">View on NSE directly →</a></p>
            </div>
          </td></tr>`;
      }
    }
  }

  // Filter button logic
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.dataset.type;
      applyFilter();
    });
  });

  // Background refresh every 5 min
  loadFeed();
  setInterval(loadFeed, 5 * 60 * 1000);
})();
</script>

</Layout>
