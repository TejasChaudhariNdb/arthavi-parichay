---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: "Investment Goal Tracker India — Track FIRE, Home & Education | Arthavi",
  description: "Track your financial goals on Arthavi. Link mutual funds and stocks to Early Retirement (FIRE), Home Down Payment, Child Education, and Emergency Funds.",
};

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Arthavi Goal Planning & Tracker",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
      "description": "Financial goal tracking mapping specific mutual fund schemes and stock holdings to target retirement and life milestones."
    }
  ]
});
---
<Layout
  title={seo.title}
  description={seo.description}
  keywords="investment goal tracker india, retirement goal tracker, fire tracker india, child education goal tracker"
  schema={schema}
  breadcrumb={{
    items: [
      { name: "Home", url: "https://arthavi.com/" },
      { name: "Goal Tracker", url: "https://arthavi.com/investment-goal-tracker/" }
    ]
  }}
>

<main style="padding-top: 7rem; padding-bottom: 5rem;">
  <section style="padding-top: 1rem; position: relative; z-index: 2;">
    <div class="container">

      <div class="section-header text-center fade-in" style="margin-bottom: 3.5rem;">
        <span style="display:inline-block; background: rgba(245,158,11,0.12); border: 1px solid rgba(245,158,11,0.3); color: #fbbf24; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 100px; margin-bottom: 1rem;">Goal-Based Investing · Milestones</span>
        <h1 class="heading-xl" style="margin-bottom: 1rem;">Investment Goal Tracker India</h1>
        <p style="max-width: 720px; margin: 0 auto; color: var(--text-muted); font-size: 1.15rem; line-height: 1.6;">
          Give every rupee a purpose. Map specific mutual funds and stocks directly to your Early Retirement (FIRE), Home Purchase, or Child's Higher Education.
        </p>
        <div style="margin-top: 2rem; display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 0.9rem 2rem;">Create My First Goal</a>
          <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 0.9rem 2rem;">View Demo</a>
        </div>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.8rem; margin-bottom: 4rem;">
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">🏖️</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">Retirement &amp; FIRE</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">Calculate your target corpus using 25x–30x annual expenses and monitor your percentage progress in real-time as NAVs grow.</p>
        </div>
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">🎓</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">Child's Education</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">Earmark specific equity funds and sovereign gold bonds for college tuition timelines 10–15 years out.</p>
        </div>
        <div class="glass-panel" style="padding: 2rem; border-radius: 16px;">
          <div style="font-size: 1.5rem; margin-bottom: 0.8rem;">🚨</div>
          <h2 style="font-size: 1.25rem; margin-top: 0; margin-bottom: 0.75rem; color: var(--text-head);">Emergency Fund Safety Net</h2>
          <p style="color: var(--text-muted); font-size: 0.92rem; line-height: 1.6; margin: 0;">Track 6–12 months of living expenses in Liquid Mutual Funds, bank FDs, and savings accounts.</p>
        </div>
      </div>

      <div style="text-align: center; padding: 2rem 0 3rem;">
        <h2 style="margin-bottom: 1rem;">Start goal-based wealth building</h2>
        <a href="https://app.arthavi.com/register" class="btn btn-primary" style="padding: 1rem 2.5rem; font-size: 1.1rem; margin-right: 1rem;">Start Tracking Free</a>
        <a href="https://app.arthavi.com/demo" class="btn btn-demo" style="padding: 1rem 2.5rem; font-size: 1.1rem;">Try Demo</a>
      </div>

    </div>
  </section>
</main>

</Layout>
