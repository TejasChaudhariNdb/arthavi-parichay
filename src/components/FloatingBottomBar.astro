---
---
<div id="floating-bottom-bar" class="floating-bottom-bar hidden">
  <div class="floating-bar-inner glass-panel-float">
    <div class="floating-bar-info">
      <div class="floating-badge">
        <span class="pulse-dot"></span>
        <span>100% Free & Privacy-First</span>
      </div>
      <p class="floating-title">Track Stocks & Mutual Funds</p>
    </div>
    
    <div class="floating-bar-actions">
      <a href="https://app.arthavi.com/demo" class="btn btn-secondary btn-sm float-demo-btn">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        Try Demo
      </a>
      <a href="https://app.arthavi.com/register" class="btn btn-primary btn-sm float-cta-btn">
        Create Free Account
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <button type="button" id="close-floating-bar" class="float-close-btn" aria-label="Close floating bar">
      ✕
    </button>
  </div>
</div>

<style>
  .floating-bottom-bar {
    position: fixed;
    bottom: max(1.2rem, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    width: calc(100% - 2rem);
    max-width: 660px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    opacity: 1;
  }

  .floating-bottom-bar.hidden {
    transform: translate(-50%, 140%);
    opacity: 0;
    pointer-events: none;
  }

  .glass-panel-float {
    background: rgba(15, 20, 30, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    padding: 0.6rem 1rem 0.6rem 1.4rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), 0 0 30px rgba(99, 102, 241, 0.25);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    position: relative;
  }

  .floating-bar-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .floating-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: #38BDF8;
    font-weight: 600;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #38BDF8;
    box-shadow: 0 0 8px #38BDF8;
    animation: pulseGlow 2s infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .floating-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .floating-bar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .float-demo-btn {
    padding: 0.5rem 0.85rem;
    font-size: 0.82rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #F3F4F6;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    text-decoration: none;
    transition: all 0.2s;
  }

  .float-demo-btn:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #FFF;
  }

  .float-cta-btn {
    padding: 0.5rem 1rem;
    font-size: 0.83rem;
    font-weight: 700;
    border-radius: 999px;
    background: linear-gradient(135deg, #5457e5 0%, #7c3aed 100%);
    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.4);
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    border: none;
    text-decoration: none;
    transition: all 0.2s;
  }

  .float-cta-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(124, 58, 237, 0.6);
  }

  .float-close-btn {
    background: none;
    border: none;
    color: #6B7280;
    font-size: 0.85rem;
    cursor: pointer;
    padding: 0.2rem 0.4rem;
    margin-left: -0.3rem;
    transition: color 0.2s;
  }

  .float-close-btn:hover {
    color: #FFF;
  }

  @media (max-width: 640px) {
    .floating-bottom-bar {
      width: calc(100% - 1.2rem);
      bottom: max(0.8rem, env(safe-area-inset-bottom));
    }

    .glass-panel-float {
      padding: 0.55rem 0.75rem 0.55rem 1rem;
      border-radius: 20px;
    }

    .floating-bar-info {
      display: none;
    }

    .floating-bar-actions {
      width: 100%;
      justify-content: space-between;
    }

    .float-demo-btn, .float-cta-btn {
      flex: 1;
      justify-content: center;
      padding: 0.6rem 0.5rem;
      font-size: 0.82rem;
    }
  }
</style>

<script>
  let isDismissed = false;

  const floatBar = document.getElementById('floating-bottom-bar');
  const closeBtn = document.getElementById('close-floating-bar');

  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      isDismissed = true;
      if (floatBar) floatBar.classList.add('hidden');
    });
  }

  window.addEventListener('scroll', () => {
    if (isDismissed || !floatBar) return;
    if (window.scrollY > 300) {
      floatBar.classList.remove('hidden');
    } else {
      floatBar.classList.add('hidden');
    }
  });
</script>
