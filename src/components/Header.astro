---
---
<header>
    <div class="container header-inner">
        <a href="/" class="logo" aria-label="Arthavi Home">
            <span class="logo-mark">
                <img src="/images/logo.webp" alt="Arthavi Logo" width="30" height="26" style="border-radius: 4px;">
            </span>
            <span class="logo-text">Arthavi</span>
        </a>
        <nav class="desktop-nav" role="navigation" aria-label="Primary navigation">
            <ul>
                <li><a href="/#features">Features</a></li>
                <li><a href="/#ask-ai" class="nav-ai-link">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275Z" />
                        </svg>
                        Ask AI
                    </a></li>
                <li><a href="/compare/">Compare</a></li>
                <li><a href="/#faq">FAQ</a></li>
            </ul>
        </nav>
        <div class="nav-actions">
            <!-- Desktop Sign In Link -->
            <a href="https://app.arthavi.com/" class="nav-signin-link desktop-only">Sign In</a>

            <!-- Desktop CTA -->
            <a href="https://app.arthavi.com/register" class="btn btn-primary nav-cta" id="nav-cta">Create Free Account</a>

            <!-- Mobile compact CTA -->
            <a href="https://app.arthavi.com/register" class="btn btn-primary btn-sm mobile-header-cta">Start Free</a>

            <!-- Mobile Hamburger Menu Button -->
            <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<nav class="mobile-menu" id="mobile-menu" role="navigation" aria-label="Mobile navigation">
    <div class="mobile-menu-header">
        <p class="mobile-menu-kicker">Privacy-first portfolio tracking</p>
        <p class="mobile-menu-copy">Track stocks and mutual funds in one place without broker logins or data selling.</p>
    </div>
    <a href="/#features" onclick="closeMobileMenu()">Features</a>
    <a href="/features/" onclick="closeMobileMenu()">All 42+ Features</a>
    <a href="/stocks/" onclick="closeMobileMenu()">📈 Stock Market Hub</a>
    <a href="/calculators/" onclick="closeMobileMenu()">🧮 Portfolio Calculators</a>
    <a href="/#ask-ai" onclick="closeMobileMenu()" style="color: #c4b5fd; font-weight:600;">✦ Ask AI Assistant</a>
    <a href="/compare/" onclick="closeMobileMenu()">Compare Trackers</a>
    <a href="/#faq" onclick="closeMobileMenu()">FAQ</a>
    <a href="/about/" onclick="closeMobileMenu()">About</a>
    <a href="/security/" onclick="closeMobileMenu()">Security</a>
    <div class="mobile-menu-actions">
        <a href="https://app.arthavi.com/register" class="btn btn-primary btn-register-mobile" style="margin-bottom: 0.75rem; text-align: center; justify-content: center; width: 100%;">Create Free Account →</a>
        <a href="https://app.arthavi.com/demo" class="btn btn-secondary btn-demo-mobile" style="text-align: center; justify-content: center; width: 100%;">⚡ Try Interactive Demo</a>
        <p style="text-align: center; margin-top: 1rem; font-size: 0.88rem; color: var(--text-muted); margin-bottom: 0;">
            Already have an account? <a href="https://app.arthavi.com/" style="color: #a78bfa; font-weight: 600;">Sign In</a>
        </p>
    </div>
</nav>

<style>
    .nav-signin-link {
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 500;
        margin-right: 0.75rem;
        transition: color 0.2s;
    }
    .nav-signin-link:hover {
        color: var(--text-head);
    }

    .mobile-header-cta {
        display: none;
        padding: 0.42rem 0.9rem;
        font-size: 0.84rem;
        font-weight: 600;
        border-radius: 8px;
        text-decoration: none;
        white-space: nowrap;
    }

    @media (max-width: 768px) {
        .desktop-only, .nav-cta {
            display: none !important;
        }

        .mobile-header-cta {
            display: inline-flex !important;
            align-items: center;
        }

        .btn-register-mobile {
            background: linear-gradient(135deg, #5457e5 0%, #7c3aed 100%);
            box-shadow: 0 4px 18px rgba(99, 102, 241, 0.4);
            display: flex;
        }

        .btn-demo-mobile {
            display: flex;
        }
    }
</style>

<script>
// Mobile menu toggle
const hamburger = document.getElementById('hamburger');
const mobileMenu = document.getElementById('mobile-menu');
function closeMobileMenu() {
    if (mobileMenu) mobileMenu.classList.remove('open');
    if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
}
if (typeof window !== 'undefined') {
    (window as any).closeMobileMenu = closeMobileMenu;
}
if (hamburger) {
    hamburger.addEventListener('click', function () {
        const open = mobileMenu ? mobileMenu.classList.toggle('open') : false;
        hamburger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
}
// Make links close menu
document.querySelectorAll('.mobile-menu a').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
});
</script>
